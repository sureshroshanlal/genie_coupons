---
import Base from "../../../layouts/Base.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import SubcategoryMerchants from "../../../components/SubcategoryMerchants.jsx";

const { parentSlug, subSlug } = Astro.params;
const apiUrl = import.meta.env.PUBLIC_API_BASE_URL;

let subcategoryData = null;

try {
  const response = await fetch(
    `${apiUrl}/categories/${parentSlug}/${subSlug}?limit=20`,
  );
  if (response.ok) {
    const result = await response.json();
    subcategoryData = result.data;
  }
} catch (error) {
  console.error("Error fetching subcategory:", error);
}

if (!subcategoryData) return Astro.redirect("/404");

const pageTitle =
  subcategoryData.subcategory.meta_title ||
  `${subcategoryData.subcategory.name} Stores - ${subcategoryData.parent.name}`;
const pageDesc =
  subcategoryData.subcategory.meta_description ||
  `Browse ${subcategoryData.subcategory.name} stores and find the best coupons and deals.`;
const canonical = `https://geniecoupon.com/categories/${parentSlug}/${subSlug}`;
---

<Base meta={{ title: pageTitle, description: pageDesc, canonical }}>
  <Header />
  <main class="container mx-auto px-4 py-10">
    <!-- Breadcrumb -->
    <nav
      class="mb-6 text-sm"
      style="color: var(--text-secondary);"
      aria-label="Breadcrumb"
    >
      <ol class="flex items-center gap-2 flex-wrap">
        <li>
          <a
            href="/categories"
            class="hover:text-brand-primary transition-colors">Categories</a>
        </li>
        <li style="color: var(--text-muted);">/</li>
        <li>
          <a
            href={`/categories/${parentSlug}`}
            class="hover:text-brand-primary transition-colors"
            >{subcategoryData.parent.name}</a>
        </li>
        <li style="color: var(--text-muted);">/</li>
        <li class="font-semibold" style="color: var(--text-primary);">
          {subcategoryData.subcategory.name}
        </li>
      </ol>
    </nav>

    <!-- Hero -->
    <section class="mt-6 mb-10">
      {
        subcategoryData.subcategory.thumb_url && (
          <div
            class="w-full h-48 md:h-56 rounded-2xl overflow-hidden mb-6"
            style="background: var(--bg-subtle); border: 1px solid var(--border-default);"
          >
            <img
              src={subcategoryData.subcategory.thumb_url}
              alt={subcategoryData.subcategory.name}
              class="w-full h-full object-contain p-4"
            />
          </div>
        )
      }
      <div class="text-center md:text-left">
        <h1
          class="text-3xl md:text-4xl font-extrabold text-brand-primary leading-tight mb-3"
        >
          {subcategoryData.subcategory.name}
        </h1>
        {
          subcategoryData.subcategory.description && (
            <p
              class="max-w-2xl mx-auto md:ml-0 mb-6"
              style="color: var(--text-secondary);"
            >
              {subcategoryData.subcategory.description}
            </p>
          )
        }
        <div class="flex flex-wrap gap-3 justify-center md:justify-start">
          <span class="pill pill-green"
            >{subcategoryData.pagination.total} stores</span
          >
          <span class="pill pill-gray">{subcategoryData.parent.name}</span>
        </div>
      </div>
    </section>

    <SubcategoryMerchants
      client:load
      apiUrl={apiUrl}
      parentSlug={parentSlug}
      subSlug={subSlug}
      initialData={subcategoryData}
    />
  </main>
  <Footer />
</Base>
