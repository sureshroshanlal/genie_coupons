---
import Base from "../../../layouts/Base.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import SubcategoryMerchants from "../../../components/SubcategoryMerchants.jsx";

const { parentSlug, subSlug } = Astro.params;
const apiUrl = import.meta.env.PUBLIC_API_BASE_URL;

let subcategoryData = null;

try {
  const response = await fetch(
    `${apiUrl}/categories/${parentSlug}/${subSlug}?limit=20`,
  );
  if (response.ok) {
    const result = await response.json();
    subcategoryData = result.data;
  }
} catch (error) {
  console.error("Error fetching subcategory:", error);
}

if (!subcategoryData) return Astro.redirect("/404");

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Categories", url: "/categories" },
  {
    name: subcategoryData.parent.name,
    url: `/categories/${parentSlug}`,
  },
  {
    name: subcategoryData.subcategory.name,
    url: `/categories/${parentSlug}/${subSlug}`,
  },
];

const pageTitle =
  subcategoryData.subcategory.meta_title ||
  `${subcategoryData.subcategory.name} Stores - ${subcategoryData.parent.name}`;
const pageDesc =
  subcategoryData.subcategory.meta_description ||
  `Browse ${subcategoryData.subcategory.name} stores and find the best coupons and deals.`;
const canonical = `https://geniecoupon.com/categories/${parentSlug}/${subSlug}`;
---

<Base meta={{ title: pageTitle, description: pageDesc, canonical }}>
  <Header />
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <Breadcrumbs breadcrumbs={breadcrumbs} />

    {/* ── HERO ── */}
    <section
      class="store-hero mt-4"
      aria-label={`${subcategoryData.subcategory.name} subcategory page`}
    >
      <div class="store-hero-layout">
        <div class="store-hero-left">
          <div class="store-hero-inner">
            <div class="store-hero-logo">
              {
                subcategoryData.subcategory.thumb_url ? (
                  <img
                    src={subcategoryData.subcategory.thumb_url}
                    alt={`${subcategoryData.subcategory.name} category`}
                    width="80"
                    height="80"
                    class="object-contain max-h-full max-w-full"
                    loading="eager"
                    decoding="async"
                  />
                ) : (
                  <span class="text-sm font-semibold" style="color:#707068;">
                    {subcategoryData.subcategory.name.charAt(0)}
                  </span>
                )
              }
            </div>
            <div class="store-hero-meta">
              <h1 class="store-hero-name">
                {subcategoryData.subcategory.name}
              </h1>
              {
                subcategoryData.subcategory.description && (
                  <p class="store-hero-desc">
                    {subcategoryData.subcategory.description}
                  </p>
                )
              }
              <div class="store-hero-pills">
                <span class="pill pill-green">
                  <svg
                    class="w-3 h-3 mr-1"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                    ></path>
                  </svg>
                  {subcategoryData.pagination.total} stores
                </span>
                <span class="pill pill-gray">
                  {subcategoryData.parent.name}
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="mt-12">
      <SubcategoryMerchants
        client:load
        apiUrl={apiUrl}
        parentSlug={parentSlug}
        subSlug={subSlug}
        initialData={subcategoryData}
      />
    </div>
  </main>
  <Footer />
</Base>
