---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const pageMeta = {
  title: "Contact Genie Coupon",
  description:
    "Get in touch with the Genie Coupon team for questions, partnerships, and support.",
};

const contactOrg = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  mainEntity: {
    "@type": "Organization",
    name: "Genie Coupon",
    email: "connect.geniecoupon@gmail.com",
    contactPoint: [
      {
        "@type": "ContactPoint",
        contactType: "customer support",
        email: "support.geniecoupon@gmail.com",
      },
      {
        "@type": "ContactPoint",
        contactType: "partnerships",
        email: "partnerships.geniecoupon@gmail.com",
      },
    ],
  },
};

const contacts = [
  {
    id: "general",
    title: "General Inquiries",
    desc: "Questions about Genie Coupon, how it works, or anything else.",
    email: "hello.geniecoupon@gmail.com",
  },
  {
    id: "partnerships",
    title: "Partnerships",
    desc: "Want to list your store or explore co-marketing opportunities?",
    email: "partnerships.geniecoupon@gmail.com",
  },
  {
    id: "support",
    title: "Support",
    desc: "Having trouble with a code or your account? We're here.",
    email: "support.geniecoupon@gmail.com",
  },
  {
    id: "feedback",
    title: "Feedback",
    desc: "Spotted an expired code or want to suggest a store? Tell us and we'll review it fast.",
    email: "hello.geniecoupon@gmail.com",
  },
];
---

<Base meta={pageMeta}>
  <Header />

  <main
    role="main"
    aria-labelledby="contact-heading"
    class="container mx-auto px-4 py-10"
  >
    <div class="max-w-3xl mx-auto">
      <div class="mb-8">
        <h1
          id="contact-heading"
          class="text-3xl font-extrabold text-brand-primary"
        >
          Get in Touch
        </h1>
        <div
          class="mt-2 h-1 w-16 rounded-full"
          style="background: linear-gradient(90deg,#89E900,#2d5200);"
        >
        </div>
        <p class="mt-3 text-sm" style="color: var(--text-muted);">
          We're a small team and we actually read every email. Pick the right
          channel below.
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {
          contacts.map((c) => (
            <article
              class="card-base p-5 flex flex-col gap-3"
              aria-labelledby={`contact-${c.id}`}
            >
              <h2
                id={`contact-${c.id}`}
                class="text-sm font-bold"
                style="color: var(--text-primary);"
              >
                {c.title}
              </h2>
              <p class="text-sm flex-1" style="color: var(--text-secondary);">
                {c.desc}
              </p>
              <address class="not-italic">
                <a
                  href={`mailto:${c.email}`}
                  class="text-sm font-semibold hover:underline"
                  style="color: #89E900;"
                >
                  {c.email}
                </a>
              </address>
            </article>
          ))
        }
      </div>

      <div
        class="mt-6 rounded-lg px-4 py-3 text-sm text-center"
        style="background: rgba(137,233,0,0.05); border: 1px solid rgba(137,233,0,0.12); color: var(--text-muted);"
      >
        We typically respond within 1–2 business days. For urgent coupon issues,
        email support directly.
      </div>
    </div>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(contactOrg)} />
  <Footer />
</Base>
