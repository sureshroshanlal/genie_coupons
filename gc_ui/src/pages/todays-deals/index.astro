---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CouponFilterTabs from "../../components/islands/CouponFilterTabs.jsx";
import { api } from "../../lib/api";

type Coupon = {
  id: string | number;
  title?: string | null;
  code?: string | null;
  ends_at?: string | null;
  coupon_type?: string | null;
  discount_type?: string | null;
  discount_value?: string | null;
  merchant_name?: string | null;
  is_editor?: boolean | null;
  merchant?: {
    id?: number | null;
    slug?: string | null;
    logo_url?: string | null;
    affl_url?: string | null;
    web_url?: string | null;
  } | null;
};

type CouponsResponse = {
  data: Coupon[];
  meta: {
    limit?: number;
    has_more?: boolean;
    next_cursor?: string | null;
    next?: string | null;
  };
};

const fetchSection = async (sort: string, type: string): Promise<Coupon[]> => {
  try {
    const params = new URLSearchParams({
      cursor: "",
      limit: "8",
      type,
      status: "active",
      sort,
      locale: "en",
    });
    const resp = await api.get<CouponsResponse>(
      `/coupons?${params}`,
      {},
      { retries: 2, timeout: 8000 },
    );
    return resp?.data || [];
  } catch (e) {
    console.error(`Failed to fetch coupons [sort=${sort}, type=${type}]:`, e);
    return [];
  }
};

const [latestCoupons, editorCoupons, couponsCoupons, dealsCoupons] =
  await Promise.all([
    fetchSection("latest", "all"),
    fetchSection("editor", "all"),
    fetchSection("latest", "coupon"),
    fetchSection("latest", "deal"),
  ]);

const totalDeals = new Set([
  ...latestCoupons.map((c) => c.id),
  ...editorCoupons.map((c) => c.id),
  ...couponsCoupons.map((c) => c.id),
  ...dealsCoupons.map((c) => c.id),
]).size;

const totalStores = new Set([
  ...latestCoupons.map((c) => c.merchant?.slug).filter(Boolean),
  ...editorCoupons.map((c) => c.merchant?.slug).filter(Boolean),
  ...couponsCoupons.map((c) => c.merchant?.slug).filter(Boolean),
  ...dealsCoupons.map((c) => c.merchant?.slug).filter(Boolean),
]).size;

const sections = [
  {
    id: "latest",
    label: "Latest Deals",
    icon: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
    count: latestCoupons.length,
  },
  {
    id: "editor",
    label: "Editor's Picks",
    icon: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>`,
    count: editorCoupons.length,
  },
  {
    id: "coupons",
    label: "Coupons",
    icon: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"/></svg>`,
    count: couponsCoupons.length,
  },
  {
    id: "deals",
    label: "Deals",
    icon: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
    count: dealsCoupons.length,
  },
];

const now = new Date();
const updatedAt = now.toLocaleTimeString("en-US", {
  hour: "2-digit",
  minute: "2-digit",
  hour12: true,
});

const pageTitle = "Today's Deals — Genie Coupon";
const pageDesc =
  "Hand-picked coupons, editor favourites, and the freshest deals — all in one place.";
const canonical = "https://geniecoupon.com/todays-deals";
---

<Base meta={{ title: pageTitle, description: pageDesc, canonical }}>
  <Header />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    {/* ── HERO ── */}
    <section class="deals-hero" aria-label="Today's Deals">
      {/* Background decoration */}
      <div class="deals-hero-bg" aria-hidden="true">
        <div class="deals-hero-glow"></div>
        <div class="deals-hero-dots"></div>
      </div>

      <div class="deals-hero-inner">
        {/* Live badge */}
        <div class="deals-hero-badge">
          <span class="deals-hero-badge-dot"></span>
          Live & Verified
        </div>

        {/* Title */}
        <h1 class="deals-hero-title">
          Today's <span class="deals-hero-title-accent">Deals</span>
        </h1>
        <p class="deals-hero-sub">{pageDesc}</p>

        {/* Stats row */}
        <div class="deals-hero-stats">
          <div class="deals-stat">
            <span class="deals-stat-value">{totalDeals}+</span>
            <span class="deals-stat-label">Active Deals</span>
          </div>
          <div class="deals-stat-divider" aria-hidden="true"></div>
          <div class="deals-stat">
            <span class="deals-stat-value">{totalStores}+</span>
            <span class="deals-stat-label">Stores</span>
          </div>
          <div class="deals-stat-divider" aria-hidden="true"></div>
          <div class="deals-stat">
            <span class="deals-stat-value">{editorCoupons.length}</span>
            <span class="deals-stat-label">Editor Picks</span>
          </div>
          <div class="deals-stat-divider" aria-hidden="true"></div>
          <div class="deals-stat">
            <span class="deals-stat-value">{updatedAt}</span>
            <span class="deals-stat-label">Last Updated</span>
          </div>
        </div>

        {/* Section anchors */}
        <nav class="deals-hero-nav" aria-label="Jump to section">
          {
            sections.map((s) => (
              <a href={`#${s.id}`} class="deals-hero-anchor">
                <span set:html={s.icon} />
                {s.label}
                {s.count > 0 && (
                  <span class="deals-hero-anchor-count">{s.count}</span>
                )}
              </a>
            ))
          }
        </nav>
      </div>
    </section>

    {/* ── SECTIONS ── */}
    <div class="mt-14 space-y-16">
      {
        latestCoupons.length > 0 && (
          <section id="latest" aria-labelledby="heading-latest">
            <div class="deals-section-heading">
              <div class="deals-section-heading-left">
                <span class="deals-section-icon">
                  <svg
                    class="w-5 h-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#89E900"
                    stroke-width="2.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                    />
                  </svg>
                </span>
                <h2 id="heading-latest" class="section-heading">
                  Latest Deals
                </h2>
                <span class="deals-section-count">{latestCoupons.length}</span>
              </div>
              <a href="#top" class="deals-back-top">
                ↑ Top
              </a>
            </div>
            {/* @ts-ignore */}
            <CouponFilterTabs
              client:load
              coupons={latestCoupons}
              storeSlug=""
            />
          </section>
        )
      }

      {
        editorCoupons.length > 0 && (
          <section id="editor" aria-labelledby="heading-editor">
            <div class="deals-section-heading">
              <div class="deals-section-heading-left">
                <span class="deals-section-icon">
                  <svg
                    class="w-5 h-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#89E900"
                    stroke-width="2.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"
                    />
                  </svg>
                </span>
                <h2 id="heading-editor" class="section-heading">
                  Editor's Picks
                </h2>
                <span class="deals-section-count">{editorCoupons.length}</span>
              </div>
              <a href="#top" class="deals-back-top">
                ↑ Top
              </a>
            </div>
            {/* @ts-ignore */}
            <CouponFilterTabs
              client:load
              coupons={editorCoupons}
              storeSlug=""
            />
          </section>
        )
      }

      {
        couponsCoupons.length > 0 && (
          <section id="coupons" aria-labelledby="heading-coupons">
            <div class="deals-section-heading">
              <div class="deals-section-heading-left">
                <span class="deals-section-icon">
                  <svg
                    class="w-5 h-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#89E900"
                    stroke-width="2.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"
                    />
                  </svg>
                </span>
                <h2 id="heading-coupons" class="section-heading">
                  Coupons
                </h2>
                <span class="deals-section-count">{couponsCoupons.length}</span>
              </div>
              <a href="#top" class="deals-back-top">
                ↑ Top
              </a>
            </div>
            {/* @ts-ignore */}
            <CouponFilterTabs
              client:load
              coupons={couponsCoupons}
              storeSlug=""
            />
          </section>
        )
      }

      {
        dealsCoupons.length > 0 && (
          <section id="deals" aria-labelledby="heading-deals">
            <div class="deals-section-heading">
              <div class="deals-section-heading-left">
                <span class="deals-section-icon">
                  <svg
                    class="w-5 h-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#89E900"
                    stroke-width="2.5"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                    />
                  </svg>
                </span>
                <h2 id="heading-deals" class="section-heading">
                  Deals
                </h2>
                <span class="deals-section-count">{dealsCoupons.length}</span>
              </div>
              <a href="#top" class="deals-back-top">
                ↑ Top
              </a>
            </div>
            {/* @ts-ignore */}
            <CouponFilterTabs client:load coupons={dealsCoupons} storeSlug="" />
          </section>
        )
      }
    </div>
  </main>

  <Footer />
</Base>

<style>
  /* ── Hero ── */
  .deals-hero {
    margin-top: 1rem;
    padding: 3rem 2.5rem;
    border-radius: 1.5rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    position: relative;
    overflow: hidden;
  }

  /* Background layers */
  .deals-hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    border-radius: inherit;
  }

  .deals-hero-glow {
    position: absolute;
    top: -60px;
    right: -60px;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(137, 233, 0, 0.12) 0%,
      transparent 70%
    );
  }

  .deals-hero-dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      circle,
      rgba(137, 233, 0, 0.12) 1px,
      transparent 1px
    );
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse at 80% 50%, black 20%, transparent 70%);
    -webkit-mask-image: radial-gradient(
      ellipse at 80% 50%,
      black 20%,
      transparent 70%
    );
  }

  .deals-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 680px;
  }

  /* Live badge */
  .deals-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #89e900;
    background: rgba(137, 233, 0, 0.08);
    border: 1px solid rgba(137, 233, 0, 0.2);
    border-radius: 999px;
    padding: 0.3rem 0.875rem;
    margin-bottom: 1.25rem;
  }

  .deals-hero-badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #89e900;
    flex-shrink: 0;
    box-shadow: 0 0 0 0 rgba(137, 233, 0, 0.4);
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(137, 233, 0, 0.4);
    }
    50% {
      box-shadow: 0 0 0 5px rgba(137, 233, 0, 0);
    }
  }

  /* Title */
  .deals-hero-title {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 0.875rem;
  }

  .deals-hero-title-accent {
    color: #89e900;
  }

  .deals-hero-sub {
    font-size: 1rem;
    color: var(--text-secondary);
    max-width: 520px;
    line-height: 1.65;
    margin-bottom: 2rem;
  }

  /* Stats row */
  .deals-hero-stats {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0;
    margin-bottom: 2rem;
    padding: 1rem 1.25rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border-default);
    border-radius: 0.875rem;
    width: fit-content;
  }

  .deals-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 1.25rem;
    gap: 0.2rem;
  }

  .deals-stat:first-child {
    padding-left: 0;
  }

  .deals-stat-value {
    font-size: 1.25rem;
    font-weight: 800;
    color: #89e900;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .deals-stat-label {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .deals-stat-divider {
    width: 1px;
    height: 2rem;
    background: var(--border-default);
    flex-shrink: 0;
  }

  /* Anchor nav */
  .deals-hero-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .deals-hero-anchor {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-secondary);
    background: var(--bg-subtle);
    border: 1px solid var(--border-default);
    text-decoration: none;
    transition:
      background 150ms ease,
      color 150ms ease,
      border-color 150ms ease,
      transform 150ms ease;
  }

  .deals-hero-anchor:hover {
    background: rgba(137, 233, 0, 0.1);
    color: #89e900;
    border-color: rgba(137, 233, 0, 0.3);
    transform: translateY(-1px);
  }

  .deals-hero-anchor-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.25rem;
    height: 1.25rem;
    padding: 0 0.3rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    background: rgba(137, 233, 0, 0.15);
    color: #89e900;
  }

  /* ── Section headings ── */
  .deals-section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-default);
    position: relative;
  }

  .deals-section-heading::after {
    content: "";
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 3rem;
    height: 2px;
    background: #89e900;
    border-radius: 999px;
  }

  .deals-section-heading-left {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .deals-section-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.625rem;
    background: rgba(137, 233, 0, 0.08);
    border: 1px solid rgba(137, 233, 0, 0.15);
    flex-shrink: 0;
  }

  .deals-section-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    background: rgba(137, 233, 0, 0.1);
    color: #89e900;
    border: 1px solid rgba(137, 233, 0, 0.15);
  }

  .deals-back-top {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    text-decoration: none;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--border-default);
    transition:
      color 150ms ease,
      border-color 150ms ease,
      background 150ms ease;
  }

  .deals-back-top:hover {
    color: #89e900;
    border-color: rgba(137, 233, 0, 0.3);
    background: rgba(137, 233, 0, 0.06);
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .deals-hero {
      padding: 2rem 1.25rem;
    }

    .deals-hero-stats {
      width: 100%;
      justify-content: space-between;
      padding: 0.875rem 1rem;
    }

    .deals-stat {
      padding: 0 0.5rem;
    }

    .deals-stat-value {
      font-size: 1.1rem;
    }
  }
</style>
