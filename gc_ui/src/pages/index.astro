---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LandingSubscribeIsland from "../components/islands/LandingSubscribeIsland.jsx";
import { SAMPLE_TESTIMONIALS } from "../content/testimonials.sample";
import CoverflowCarousel from "../components/CoverflowCarousel.jsx";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CardStore from "../components/CardStore.astro";
import MerchantProofsIsland from "../components/islands/MerchantProofsIsland.jsx";
import CouponFilterTabs from "../components/islands/CouponFilterTabs.jsx";
import SubscribeBox from "../components/SubscribeBox.jsx";
import FaqAccordion from "../components/FAQAccordion.jsx";
import WhyTrustUs from "../components/WhyTrustUs.jsx";
import DOMPurify from "isomorphic-dompurify";
import { api } from "../lib/api";
import SavingsImpact from "../components/SavingsImpact.astro";
import FeedbackForm from "../components/islands/FeedbackForm.jsx";
import VerifiedBadge from "../components/VerifiedBadge.astro";
import PopularCategories from "../components/CategoriesSection.jsx";
import StoresSection from "../components/StoresSection.jsx";
import DealsSection from "../components/DealsSection.jsx";
import TestimonialsCarousel from "../components/TestimonialsCarousel.jsx";
import Img from "../components/Img.astro";

// ── Subdomain detection ──
const storeSlug = Astro.locals?.storeSlug ?? null;
const isStoreSubdomain = Astro.locals?.isSubdomain === true;

// ── Types ──
type Coupon = {
  id: string | number;
  title?: string | null;
  coupon_type?: string | null;
  ends_at?: string | null;
  merchant_name?: string | null;
  discount_type?: string | null;
  discount_value?: string | null;
  is_editor?: boolean | null;
  reviews?: any[] | null;
  review_aggregate?: { avg_rating: number; total: number } | null;
  merchant?: {
    slug?: string | null;
    logo_url?: string | null;
    affl_url?: string | null;
    web_url?: string | null;
  };
};

type StoreDetail = {
  id: number | string;
  slug: string;
  name: string;
  verifier_id?: number | string | null;
  aff_url?: string | null;
  web_url?: string | null;
  logo_url?: string | null;
  category_names?: string[];
  category_id?: number | string | null;
  subcategory_id?: number | string | null;
  side_description_html?: string | null;
  description_html?: string | null;
  about_html?: string | null;
  breadcrumbs?: { name: string; url: string }[];
  stats?: { active_coupons?: number };
  coupons?: {
    items: Coupon[];
    page?: number;
    limit?: number;
    total?: number;
  };
  related_stores?: {
    id: string | number;
    name: string;
    slug: string;
    logo_url?: string | null;
  }[];
  faqs?: { question: string; answer: string }[];
  trust_text?: string | null;
  verifier?: {
    id: number | string;
    name: string;
    slug: string;
    verifying_since?: string;
    avatar_url?: string | null;
    designation: string;
    same_as?: { type: string; url: string }[];
    created_at: string;
  };
};

type StoreDetailResponse = {
  data: StoreDetail | null;
  meta?: {
    canonical?: string;
    jsonld?: any;
    title?: string;
    description?: string;
  };
};

// ── Homepage data ──
const apiUrl = import.meta.env.PUBLIC_API_BASE_URL;
let banners = [];
try {
  const res = await fetch(`${apiUrl}/banners`);
  const json = await res.json();
  banners = json?.data || [];
} catch (e) {
  console.error("Failed to fetch banners:", e);
  banners = [];
}

let homeStores = [];
let homeCoupons = [];
let homeCategories = [];

try {
  const [storesRes, couponsRes, categoriesRes] = await Promise.all([
    fetch(`${apiUrl}/stores?mode=homepage&limit=8`),
    fetch(`${apiUrl}/coupons?mode=homepage&limit=6&status=active`),
    fetch(`${apiUrl}/categories?show_home=true&limit=8`),
  ]);
  homeStores = (await storesRes.json())?.data || [];
  homeCoupons = (await couponsRes.json())?.data || [];
  homeCategories = (await categoriesRes.json())?.data || [];
} catch (e) {
  console.error("Failed to fetch home sections:", e);
}

const pageMeta = {
  title: "Genie Coupon | Verified Coupons & Discounts",
  description:
    "Verified coupons, real savings, no expired junk — handpicked by real humans.",
};
const avg =
  SAMPLE_TESTIMONIALS.reduce((s: number, t: any) => s + (t.rating || 0), 0) /
    SAMPLE_TESTIMONIALS.length || null;

// ── Store data ──
let store: StoreDetail | null = null;
let storeMeta: any = {};
let proofs: any[] = [];
let breadcrumbs: any[] = [];

if (isStoreSubdomain && storeSlug) {
  try {
    const resp = await api.get<StoreDetailResponse>(
      `/stores/${storeSlug}?limit100`,
      {},
      { retries: 2, timeout: 8000 },
    );
    store = resp?.data || null;
    storeMeta = resp?.meta || {};

    if (!store) return Astro.redirect("/404");

    // breadcrumbs = store.breadcrumbs || [];
    breadcrumbs = [
      { name: "Home", url: "https://geniecoupon.com" },
      { name: "Stores", url: "https://geniecoupon.com/stores" },
      { name: store.name, url: `https://${storeSlug}.geniecoupon.com` },
    ];

    const refType = Astro.url.searchParams.get("ref");
    const parentSlug = Astro.url.searchParams.get("parent");
    const subSlug = Astro.url.searchParams.get("sub");
    if (refType === "category" && parentSlug && subSlug) {
      try {
        const res = await fetch(
          `${apiUrl}/categories/${parentSlug}/${subSlug}`,
        );
        const catData = await res.json();
        if (catData?.data) {
          breadcrumbs = [
            { name: "Home", url: "https://geniecoupon.com" },
            { name: "Categories", url: "https://geniecoupon.com/categories" },
            {
              name: catData.data.parent.name,
              url: `https://geniecoupon.com/categories/${parentSlug}`,
            },
            {
              name: catData.data.subcategory.name,
              url: `https://geniecoupon.com/categories/${parentSlug}/${subSlug}`,
            },
            { name: store.name, url: `https://${storeSlug}.geniecoupon.com` },
          ];
        }
      } catch (e) {
        console.error("Breadcrumb category fetch failed:", e);
      }
    }

    try {
      const res: any = await api.get(`/stores/${store.id}/proofs`);
      proofs = res.proofs || [];
    } catch (e) {
      console.error("Error fetching proofs:", e);
    }
  } catch (e) {
    console.error("Error fetching store:", e);
    return Astro.redirect("/404");
  }
}

const visitUrl = (store as any)?.aff_url || (store as any)?.web_url || null;

// ── Sanitize HTML ──
const _ALLOWED_TAGS = [
  "h1",
  "h2",
  "h3",
  "h4",
  "p",
  "br",
  "strong",
  "b",
  "em",
  "i",
  "u",
  "s",
  "ul",
  "ol",
  "li",
  "a",
  "img",
  "blockquote",
];
const _ALLOWED_ATTR = [
  "href",
  "title",
  "rel",
  "target",
  "src",
  "alt",
  "width",
  "height",
  "id",
  "class",
  "loading",
];

const safeDescriptionHtml = store?.description_html
  ? DOMPurify.sanitize(store.description_html, {
      ALLOWED_TAGS: _ALLOWED_TAGS,
      ALLOWED_ATTR: _ALLOWED_ATTR,
    })
  : null;

// ── Store page meta ──
const activeCoupons = store?.stats?.active_coupons || 0;
const totalSavings =
  activeCoupons > 0
    ? Math.floor(
        Math.random() * (activeCoupons * 100 + 100 - activeCoupons * 100 + 1),
      ) +
      activeCoupons * 100
    : 0;

const verifier = store?.verifier;
const lastVerified = verifier
  ? `${Math.floor(Math.random() * 11) + 2} hours ago`
  : undefined;
const successRate = Math.floor(Math.random() * 7) + 92;

const pageTitle = isStoreSubdomain
  ? storeMeta?.title ||
    (store?.name
      ? `${store.name} Coupons & Deals - Genie Coupon`
      : "Store - Genie Coupon")
  : pageMeta.title;
const pageDesc = isStoreSubdomain
  ? storeMeta?.description ||
    (store?.name ? `Get the latest ${store.name} coupons and deals.` : "")
  : pageMeta.description;
const canonical = isStoreSubdomain
  ? storeMeta?.canonical || `https://${storeSlug}.geniecoupon.com`
  : "https://geniecoupon.com";
const jsonld = storeMeta?.jsonld || null;

const couponItems = store?.coupons?.items || [];
const totalCoupons = store?.coupons?.total || 0;

let siteStats = { total_coupons: 0, total_stores: 0 };
try {
  const res = await fetch(`${apiUrl}/stats`);
  const json = await res.json();
  siteStats = json?.data || siteStats;
} catch (e) {
  console.error("Failed to fetch stats:", e);
}

if (jsonld?.["@graph"]) {
  const storeUrl = `https://savingharbor.com/stores/${store?.slug}`;

  // Patch #savings-impact value
  const savingsNode = jsonld["@graph"].find((n: any) =>
    n["@id"]?.endsWith("#savings-impact"),
  );
  if (savingsNode) savingsNode.value = String(totalSavings);

  // Remove any existing proof nodes built with empty/stale data on the backend
  jsonld["@graph"] = jsonld["@graph"].filter(
    (n: any) => !n["@id"]?.includes("#verification-proof-"),
  );

  // Inject one node per proof (indexed)
  (proofs || []).forEach((proof: { image_url: any }, i: number) => {
    if (!proof?.image_url) return;
    jsonld["@graph"].push({
      "@type": "ImageObject",
      "@id": `${storeUrl}/#verification-proof-${i + 1}`,
      about: { "@id": `${storeUrl}/#merchant` },
      name: `Coupon Verification Proof ${i + 1}`,
      description: "Checkout screenshot showing successful coupon application.",
      contentUrl: proof.image_url,
    });
  });
}

// utility: returns "{Mon, YYYY}"
function getCurrentMonthYear() {
  const now = new Date();
  const month = now.toLocaleString("en-US", { month: "long" }); // e.g. "Sep"
  const year = now.getFullYear(); // e.g. 2025
  return ` ${month}, ${year}`;
}

const suffix = getCurrentMonthYear();
---

<Base
  meta={{
    title: pageTitle,
    description: pageDesc,
    canonical,
    jsonld,
  }}
>
  <Header />

  {
    isStoreSubdomain && store ? (
      <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        {/* ── Breadcrumbs ── */}
        <Breadcrumbs breadcrumbs={breadcrumbs} />

        {/* ── HERO ─────────────────────────────────────────────────────────── */}
        <section
          class="store-hero mt-4"
          aria-label={`${store.name} store page`}
        >
          <div class="store-hero-layout">
            {/* Left: logo + meta */}
            <div class="store-hero-left">
              <div class="store-hero-inner">
                <div class="store-hero-logo">
                  {visitUrl ? (
                    <a
                      href={visitUrl}
                      target="_blank"
                      rel="noopener noreferrer sponsored"
                      class="store-hero-logo"
                      aria-label={`Visit ${store.name}`}
                    >
                      {store.logo_url ? (
                        <Img
                          src={store.logo_url}
                          alt={`${store.name} logo`}
                          width="80"
                          height="80"
                          class="object-contain max-h-full max-w-full"
                          loading="eager"
                          decoding="async"
                        />
                      ) : (
                        <span
                          class="text-sm font-semibold"
                          style="color:#707068;"
                        >
                          {store.name.charAt(0)}
                        </span>
                      )}
                    </a>
                  ) : (
                    <div class="store-hero-logo">
                      {store.logo_url ? (
                        <Img
                          src={store.logo_url}
                          alt={`${store.name} logo`}
                          width="80"
                          height="80"
                          class="object-contain max-h-full max-w-full"
                          loading="eager"
                          decoding="async"
                        />
                      ) : (
                        <span
                          class="text-sm font-semibold"
                          style="color:#707068;"
                        >
                          {store.name.charAt(0)}
                        </span>
                      )}
                    </div>
                  )}
                </div>
                <div class="store-hero-meta">
                  <h1 class="store-hero-name">
                    {store.name} Verified Promo Codes & Coupons - {suffix}
                  </h1>
                  {storeMeta.description && (
                    <p class="store-hero-desc">{storeMeta.description}</p>
                  )}
                  <div class="store-hero-pills">
                    <span class="pill pill-green">
                      <svg
                        class="w-3 h-3 mr-1"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        aria-hidden="true"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"
                        />
                      </svg>
                      {totalCoupons} {totalCoupons === 1 ? "Offer" : "Offers"}
                    </span>
                    <span class="pill pill-gray">
                      <svg
                        class="w-3 h-3 mr-1"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        aria-hidden="true"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                        />
                      </svg>
                      Updated today
                    </span>
                    {store.category_names &&
                      store.category_names.length > 0 && (
                        <span class="pill pill-gray">
                          {store.category_names[0]}
                        </span>
                      )}
                    {visitUrl && (
                      <a
                        href={visitUrl}
                        target="_blank"
                        rel="noopener noreferrer sponsored"
                        class="store-hero-visit-btn"
                      >
                        <svg
                          class="w-3 h-3"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.5"
                          aria-hidden="true"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                          />
                        </svg>
                        Visit Store
                      </a>
                    )}
                    <a href="#about-section" class="store-hero-about-link">
                      About {store.name} ↓
                    </a>
                  </div>
                </div>
              </div>
            </div>

            {/* Right: proofs column — vertical on desktop, horizontal strip on mobile */}
            {proofs.length > 0 && (
              <div class="store-hero-proofs-col">
                <div class="store-hero-proofs-label">
                  <svg
                    class="w-3 h-3"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#89E900"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                    />
                  </svg>
                  Verified Proofs
                </div>
                <MerchantProofsIsland
                  client:visible
                  proofs={proofs}
                  mode="strip"
                  visitUrl={visitUrl}
                />
              </div>
            )}
          </div>
        </section>

        {/* ── MAIN GRID ─────────────────────────────────────────────────────── */}
        <div class="mt-8 grid grid-cols-1 lg:grid-cols-3 gap-8">
          {/* ── Main Column ── */}
          <div class="lg:col-span-2 space-y-10">
            {/* Coupon filter tabs + cards */}
            {/* @ts-ignore */}
            <CouponFilterTabs
              client:visible
              coupons={couponItems}
              storeSlug={store.slug}
              sectionId="store"
            />

            {/* About this store */}
            {safeDescriptionHtml && (
              <section id="about-section" class="card-base p-6">
                <h2 class="section-heading">About {store.name}</h2>
                <div class="about-expand-wrapper">
                  <div
                    class="about-expand-content prose max-w-none ql-editor merchant-description"
                    set:html={safeDescriptionHtml}
                  />
                  <div class="about-expand-fade" aria-hidden="true" />
                </div>
                <button
                  class="about-expand-btn"
                  onclick="
                  const wrapper = this.closest('section').querySelector('.about-expand-wrapper');
                  const fade = wrapper.querySelector('.about-expand-fade');
                  const content = wrapper.querySelector('.about-expand-content');
                  const isExpanded = wrapper.dataset.expanded === 'true';
                  if (isExpanded) {
                    wrapper.dataset.expanded = 'false';
                    content.style.maxHeight = '320px';
                    fade.style.display = 'block';
                    this.textContent = 'Read more ↓';
                  } else {
                    wrapper.dataset.expanded = 'true';
                    content.style.maxHeight = 'none';
                    fade.style.display = 'none';
                    this.textContent = 'Show less ↑';
                  }
                "
                >
                  Read more ↓
                </button>
              </section>
            )}

            {/* FAQs */}
            {store.faqs && store.faqs.length > 0 && (
              <section id="faqs-section" class="card-base p-6">
                <FaqAccordion client:visible faqs={store.faqs} />
              </section>
            )}

            {/* Related stores */}
            {store.related_stores && store.related_stores.length > 0 && (
              <section>
                <h2 class="section-heading">Similar Stores</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                  {store.related_stores.map((rs) => (
                    <CardStore store={rs} />
                  ))}
                </div>
              </section>
            )}
          </div>

          {/* ── Sidebar ── */}
          <aside
            class="lg:col-span-1 space-y-5"
            style="position: sticky; top: 1.5rem; align-self: start;"
          >
            {verifier && (
              <div class="sidebar-box p-0 overflow-hidden">
                <VerifiedBadge
                  name={verifier.name}
                  designation={verifier.designation}
                  authorSlug={verifier.slug}
                  avatarUrl={verifier.avatar_url}
                  lastVerified={lastVerified ?? ""}
                  successRate={successRate}
                  verifyingSince={verifier.verifying_since}
                  sameAs={verifier?.same_as ?? []}
                />
              </div>
            )}

            <div class="sidebar-box p-0 overflow-hidden">
              <SavingsImpact
                totalSavings={totalSavings}
                activeCoupons={activeCoupons}
              />
            </div>

            <div class="sidebar-box p-0 overflow-hidden">
              <WhyTrustUs client:visible />
            </div>

            <div class="sidebar-box p-0 overflow-hidden">
              <div class="p-4">
                <h3
                  class="text-sm font-bold uppercase tracking-widest mb-3"
                  style="color:#89E900;"
                >
                  Subscribe and Stay Updated.
                </h3>
                <SubscribeBox client:visible source={store.slug} />
              </div>
            </div>

            <div class="sidebar-box p-0 overflow-hidden">
              <FeedbackForm client:visible storeSlug={store.slug} />
            </div>

            {store.trust_text && (
              <p class="text-xs px-1" style="color:#707068;">
                {store.trust_text}
              </p>
            )}
          </aside>
        </div>
      </main>
    ) : isStoreSubdomain && !store ? (
      <main class="max-w-7xl mx-auto px-4 py-20 text-center">
        <h1 class="text-2xl font-bold text-brand-primary">Store not found</h1>
        <p class="text-text-secondary mt-2">
          Please check the URL or browse all stores.
        </p>
        <a
          href="https://geniecoupon.com/stores"
          class="btn btn-primary mt-4 inline-block"
        >
          Browse Stores
        </a>
      </main>
    ) : (
      <main class="container mx-auto px-4 pt-4 pb-8">
        {/* ── Hero — two column: text left, carousel right ── */}
        <section class="homepage-hero-2col">
          {/* Left: text */}
          <div class="homepage-hero-left">
            <h1 class="homepage-hero-headline">
              Save More on <span style="color:#89E900;">Every Purchase.</span>
            </h1>
            <p class="homepage-hero-sub">
              Verified coupons, real savings — handpicked and tested by real
              humans.
            </p>
            <div class="homepage-hero-stats">
              <span class="pill pill-green">
                <svg
                  class="w-3 h-3 mr-1"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"
                  />
                </svg>
                {siteStats.total_coupons}+ verified coupons
              </span>
              <span class="pill pill-gray">
                <svg
                  class="w-3 h-3 mr-1"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                  />
                </svg>
                {siteStats.total_stores}+ stores
              </span>
              <span class="pill pill-gray">
                <svg
                  class="w-3 h-3 mr-1"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                  />
                </svg>
                Updated daily
              </span>
            </div>{" "}
            <div class="homepage-hero-ctas">
              <a href="/stores" class="btn btn-primary">
                Browse Stores
              </a>
              <a href="/todays-deals" class="btn btn-outline--dark">
                Today's Deals
              </a>
              <a href="/categories" class="btn btn-outline--dark">
                Categories
              </a>
            </div>
          </div>

          {/* Right: portrait coverflow carousel */}
          <div class="homepage-hero-right">
            {/* @ts-ignore */}
            <CoverflowCarousel client:visible banners={banners} />
          </div>
        </section>

        <StoresSection stores={homeStores} />
        <DealsSection coupons={homeCoupons} />
        <PopularCategories categories={homeCategories} />
        <TestimonialsCarousel
          client:visible
          items={SAMPLE_TESTIMONIALS}
          avgRating={avg}
          totalReviews={SAMPLE_TESTIMONIALS.length}
        />
        {/* ── Subscribe CTA ── */}
        <section
          class="homepage-subscribe mt-12"
          aria-labelledby="newsletter-cta-heading"
        >
          <h2 id="newsletter-cta-heading" class="homepage-subscribe-heading">
            Subscribe and stay ahead — no spam, ever.
          </h2>
          <p class="homepage-subscribe-sub">
            Get the best deals delivered weekly.
          </p>
          <LandingSubscribeIsland client:visible />
        </section>
      </main>
    )
  }

