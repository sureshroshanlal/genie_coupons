---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LandingSubscribeIsland from "../components/islands/LandingSubscribeIsland.jsx";
import { SAMPLE_TESTIMONIALS } from "../content/testimonials.sample";
import CoverflowCarousel from "../components/CoverflowCarousel.jsx";
import PopularCategories from "../components/CategoriesSection.jsx";
import StoresSection from "../components/StoresSection.jsx";
import DealsSection from "../components/DealsSection.astro";
import TestimonialsCarousel from "../components/TestimonialsCarousel.jsx";

// ── Homepage data ──
const apiUrl = import.meta.env.PUBLIC_API_BASE_URL;
let banners = [];
try {
  const res = await fetch(`${apiUrl}/banners`);
  const json = await res.json();
  banners = json?.data || [];
} catch (e) {
  console.error("Failed to fetch banners:", e);
  banners = [];
}

let homeStores = [];
let homeCoupons = [];
let homeCategories = [];

try {
  const [storesRes, couponsRes, categoriesRes] = await Promise.all([
    fetch(`${apiUrl}/stores?mode=homepage&limit=8`),
    fetch(`${apiUrl}/coupons?mode=homepage&limit=6&status=active`),
    fetch(`${apiUrl}/categories?show_home=true&limit=8`),
  ]);
  homeStores = (await storesRes.json())?.data || [];
  homeCoupons = (await couponsRes.json())?.data || [];
  homeCategories = (await categoriesRes.json())?.data || [];
} catch (e) {
  console.error("Failed to fetch home sections:", e);
}

const pageMeta = {
  title: "Genie Coupon | Best Deals & Coupons Online",
  description:
    "Verified coupons, real savings, no expired junk — handpicked by real humans.",
};
const avg =
  SAMPLE_TESTIMONIALS.reduce((s: number, t: any) => s + (t.rating || 0), 0) /
    SAMPLE_TESTIMONIALS.length || null;

let siteStats = { total_coupons: 0, total_stores: 0 };
try {
  const res = await fetch(`${apiUrl}/stats`);
  const json = await res.json();
  siteStats = json?.data || siteStats;
} catch (e) {
  console.error("Failed to fetch stats:", e);
}

const SITE_URL = "https://geniecoupon.com";
const SITE_NAME = "Genie Coupon";
const LOGO_URL = "https://geniecoupon.com/genie_coupon_logo.webp";

const homeJsonld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${SITE_URL}/#organization`,
      name: SITE_NAME,
      url: SITE_URL,
      logo: {
        "@type": "ImageObject",
        url: LOGO_URL,
      },
    },
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      url: SITE_URL,
      name: SITE_NAME,
      publisher: { "@id": `${SITE_URL}/#organization` },
      potentialAction: {
        "@type": "SearchAction",
        target: {
          "@type": "EntryPoint",
          urlTemplate: `${SITE_URL}/stores?q={search_term_string}`,
        },
        "query-input": "required name=search_term_string",
      },
    },
    {
      "@type": "WebPage",
      "@id": `${SITE_URL}/#webpage`,
      url: SITE_URL,
      name: pageMeta.title,
      description: pageMeta.description,
      isPartOf: { "@id": `${SITE_URL}/#website` },
      about: { "@id": `${SITE_URL}/#organization` },
    },
    ...(homeStores.length > 0
      ? [
          {
            "@type": "ItemList",
            "@id": `${SITE_URL}/#featured-stores`,
            name: "Featured Stores",
            numberOfItems: String(homeStores.length),
            itemListElement: homeStores.map((s: any, i: number) => ({
              "@type": "ListItem",
              position: i + 1,
              name: s.name,
              url: `${SITE_URL}/stores/${s.slug}`,
            })),
          },
        ]
      : []),
    ...(homeCoupons.length > 0
      ? [
          {
            "@type": "ItemList",
            "@id": `${SITE_URL}/#featured-deals`,
            name: "Featured Deals",
            numberOfItems: String(homeCoupons.length),
            itemListElement: homeCoupons.map((c: any, i: number) => ({
              "@type": "ListItem",
              position: i + 1,
              item: {
                "@type": "Offer",
                name: c.title || "",
                url: c.merchant?.slug
                  ? `${SITE_URL}/stores/${c.merchant.slug}`
                  : SITE_URL,
                seller: {
                  "@type": "Organization",
                  name: c.merchant_name || c.merchant?.name || "",
                },
              },
            })),
          },
        ]
      : []),
    ...(homeCategories.length > 0
      ? [
          {
            "@type": "ItemList",
            "@id": `${SITE_URL}/#featured-categories`,
            name: "Featured Categories",
            numberOfItems: String(homeCategories.length),
            itemListElement: homeCategories.map((cat: any, i: number) => ({
              "@type": "ListItem",
              position: i + 1,
              name: cat.name,
              url: `${SITE_URL}/categories/${cat.slug}`,
            })),
          },
        ]
      : []),
  ],
};

function ensure16x9(url: string, width: number) {
  if (!url || typeof url !== "string") return url;
  if (!url.includes("cdn-transform")) return url;
  const h = Math.round((width * 9) / 16);
  if (!url.includes("height=")) {
    return `${url}&height=${h}&resize=cover`;
  }
  return url;
}

const rawFallback = banners?.[0]?.variants?.fallback || null;
const lcpSrc = rawFallback ? ensure16x9(rawFallback, 516) : null;
const webpList = banners?.[0]?.variants?.webp || [];
const heroWidths = webpList.length === 4 ? [360, 516, 800, 1200] : [360, 516, 800];
const lcpSrcset =
  webpList.length > 0
    ? webpList.map((url: string, i: number) => {
        const w = heroWidths[i] || 516;
        return `${ensure16x9(url, w)} ${w}w`;
      }).join(", ")
    : null;
const heroSizes = "(max-width: 640px) 78vw, (max-width: 1024px) 65vw, 650px";
---

<Base
  meta={{
    title: pageMeta.title,
    description: pageMeta.description,
    canonical: "https://geniecoupon.com",
    jsonld: homeJsonld,
    preloadHero: !!lcpSrc,
    heroSrc: lcpSrc,
    heroSrcSetWebp: lcpSrcset,
    heroSizes,
  }}
>
  <Header />

  <main class="container mx-auto px-4 pt-4 pb-8">
    {/* ── Hero — two column: text left, carousel right ── */}
    <section class="homepage-hero-2col">
      {/* Left: text */}
      <div class="homepage-hero-left">
        <h1 class="homepage-hero-headline">
          Save More on <span style="color:#89E900;">Every Purchase.</span>
        </h1>
        <p class="homepage-hero-sub">
          Verified coupons, real savings — handpicked and tested by real
          humans.
        </p>
        <div class="homepage-hero-stats">
          <span class="pill pill-green">
            <svg
              class="w-3 h-3 mr-1"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"
              />
            </svg>
            {siteStats.total_coupons}+ verified coupons
          </span>
          <span class="pill pill-gray">
            <svg
              class="w-3 h-3 mr-1"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
              />
            </svg>
            {siteStats.total_stores}+ stores
          </span>
          <span class="pill pill-gray">
            <svg
              class="w-3 h-3 mr-1"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
            Updated daily
          </span>
        </div>{" "}
        <div class="homepage-hero-ctas">
          <a href="/stores" class="btn btn-primary">
            Browse Stores
          </a>
          <a href="/todays-deals" class="btn btn-outline--dark">
            Today's Deals
          </a>
          <a href="/categories" class="btn btn-outline--dark">
            Categories
          </a>
        </div>
      </div>

      {/* Right: portrait coverflow carousel */}
      <div class="homepage-hero-right">
        {/* @ts-ignore */}
        <CoverflowCarousel client:load banners={banners} />
      </div>
    </section>

    <StoresSection stores={homeStores} />
    <DealsSection coupons={homeCoupons} />
    <PopularCategories categories={homeCategories} />
    <TestimonialsCarousel
      client:visible
      items={SAMPLE_TESTIMONIALS}
      avgRating={avg}
      totalReviews={SAMPLE_TESTIMONIALS.length}
    />
    {/* ── Subscribe CTA ── */}
    <section
      class="homepage-subscribe mt-12"
      aria-labelledby="newsletter-cta-heading"
    >
      <h2 id="newsletter-cta-heading" class="homepage-subscribe-heading">
        Subscribe and stay ahead — no spam, ever.
      </h2>
      <p class="homepage-subscribe-sub">
        Get the best deals delivered weekly.
      </p>
      <LandingSubscribeIsland client:visible />
    </section>
  </main>

  <Footer />
</Base>
