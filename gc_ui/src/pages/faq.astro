---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const pageMeta = {
  title: "FAQ — Genie Coupon",
  description:
    "Answers to common questions about how Genie Coupon works, how we verify deals, and how to get the most out of the platform.",
};

const faqs = [
  {
    q: "What makes Genie Coupon different from other coupon sites?",
    a: "We actually test the codes. With 14 years in the coupon industry, we've seen every trick in the book — fake deals, expired codes kept live for clicks, affiliate spam. We built Genie Coupon to be the opposite of that. Every coupon is verified before it reaches you, and expired ones are pulled fast.",
  },
  {
    q: "How often are coupons updated?",
    a: "High-traffic stores are re-verified daily. Everything else runs on a rolling review schedule. When a code stops working, it comes down — we don't keep dead deals up for appearances.",
  },
  {
    q: "Can I submit a deal or coupon?",
    a: "Yes. If you've found a working code or a deal worth sharing, send it through our Contact page. We'll test it, and if it checks out, we'll get it listed.",
  },
  {
    q: "Is Genie Coupon free to use?",
    a: "Completely free. No account required, no paywalls, no premium tiers. Some early-access deals go to our newsletter subscribers first — but signing up for that is free too.",
  },
  {
    q: "How does Genie Coupon make money?",
    a: "Through affiliate commissions. When you use a coupon from our site and complete a purchase, we may earn a small commission from the merchant — at no cost to you. This is how we keep the lights on without charging users. See our Affiliate Disclosure for the full picture.",
  },
  {
    q: "What happens to my data?",
    a: "We don't sell it. We collect minimal data, use it only to operate the platform, and never share it with third parties for marketing. Full details are in our Privacy Policy.",
  },
  {
    q: "How do I stay updated on the best deals?",
    a: null,
    social: true,
  },
];
---

<Base meta={pageMeta}>
  <Header />
  <main class="container mx-auto px-4 py-10">
    <div class="max-w-3xl mx-auto">
      <div class="mb-8">
        <h1 class="text-3xl font-extrabold text-brand-primary">FAQ</h1>
        <div
          class="mt-2 h-1 w-16 rounded-full"
          style="background: linear-gradient(90deg,#89E900,#2d5200);"
        >
        </div>
        <p class="mt-3 text-sm" style="color: var(--text-muted);">
          Everything you need to know about how Genie Coupon works.
        </p>
      </div>

      <div class="space-y-2">
        {
          faqs.map((faq, i) => (
            <details class="faq-item" open={i === 0}>
              <summary class="faq-summary">
                <span>{faq.q}</span>
                <svg
                  class="faq-chevron w-4 h-4 flex-shrink-0"
                  viewBox="0 0 20 20"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M6 8l4 4 4-4"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </summary>
              <div class="faq-body">
                {faq.social ? (
                  <div>
                    <p class="mb-3" style="color: var(--text-secondary);">
                      Follow us for real-time deal alerts and early access
                      offers:
                    </p>
                    <div class="flex flex-wrap gap-2">
                      {[
                        {
                          label: "Facebook",
                          href: "https://www.facebook.com/people/GenieCoupons/61575535957327/",
                        },
                        {
                          label: "Instagram",
                          href: "https://www.instagram.com/genie_coupon/",
                        },
                        {
                          label: "YouTube",
                          href: "https://www.youtube.com/@GenieCoupon",
                        },
                        {
                          label: "Twitter (X)",
                          href: "https://x.com/GenieCouponz",
                        },
                      ].map((s) => (
                        <a
                          href={s.href}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold transition-all"
                          style="background: rgba(137,233,0,0.1); color: #89E900; border: 1px solid rgba(137,233,0,0.2);"
                        >
                          {s.label}
                        </a>
                      ))}
                    </div>
                  </div>
                ) : (
                  <p
                    style="color: var(--text-secondary);"
                    set:html={faq.a
                      ?.replace(
                        "/contact",
                        '<a href="/contact" style="color:#89E900;" class="hover:underline">Contact page</a>',
                      )
                      .replace(
                        "Affiliate Disclosure",
                        '<a href="/affiliate-disclosure" style="color:#89E900;" class="hover:underline">Affiliate Disclosure</a>',
                      )
                      .replace(
                        "Privacy Policy",
                        '<a href="/privacy-policy" style="color:#89E900;" class="hover:underline">Privacy Policy</a>',
                      )}
                  />
                )}
              </div>
            </details>
          ))
        }
      </div>

      <div
        class="mt-8 p-4 rounded-xl text-sm text-center"
        style="background: rgba(137,233,0,0.06); border: 1px solid rgba(137,233,0,0.15); color: var(--text-secondary);"
      >
        Still have a question? <a
          href="/contact"
          style="color:#89E900;"
          class="hover:underline font-semibold">Get in touch →</a
        >
      </div>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .faq-item {
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: 10px;
    overflow: hidden;
    transition: border-color 150ms ease;
  }

  .faq-item[open] {
    border-color: rgba(137, 233, 0, 0.25);
  }

  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.875rem 1rem;
    cursor: pointer;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
    list-style: none;
    user-select: none;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
    color: #89e900;
  }

  .faq-chevron {
    transition:
      transform 200ms ease,
      color 150ms ease;
    color: var(--text-muted);
  }

  .faq-body {
    padding: 0 1rem 0.875rem;
    font-size: 0.9rem;
    line-height: 1.7;
    border-top: 1px solid var(--border-default);
    padding-top: 0.75rem;
  }
</style>
