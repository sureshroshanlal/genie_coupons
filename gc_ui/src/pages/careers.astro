---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const pageMeta = {
  title: "Careers at Genie Coupon",
  description:
    "No open roles right now — but we're always interested in sharp people. Send us your CV.",
};
---

<Base meta={pageMeta}>
  <Header />

  <main
    role="main"
    aria-labelledby="careers-heading"
    class="container mx-auto px-4 py-10"
  >
    <div class="max-w-3xl mx-auto">
      <div class="mb-8">
        <h1
          id="careers-heading"
          class="text-3xl font-extrabold text-brand-primary"
        >
          Careers
        </h1>
        <div
          class="mt-2 h-1 w-16 rounded-full"
          style="background: linear-gradient(90deg,#89E900,#2d5200);"
        >
        </div>
        <p class="mt-3 text-sm" style="color: var(--text-muted);">
          Small team. High ownership. We move fast and build things that matter.
        </p>
      </div>

      <!-- No openings card -->
      <div class="card-base p-8 text-center mb-8">
        <div
          class="w-14 h-14 rounded-full flex items-center justify-center mx-auto mb-4"
          style="background: rgba(137,233,0,0.1); border: 1px solid rgba(137,233,0,0.2);"
        >
          <svg
            class="w-7 h-7"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#89E900"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            ></path>
          </svg>
        </div>
        <h2 class="text-xl font-bold mb-2" style="color: var(--text-primary);">
          No open roles right now
        </h2>
        <p
          class="text-sm mb-6 max-w-md mx-auto"
          style="color: var(--text-secondary);"
        >
          We don't have active openings at the moment, but we're always
          interested in sharp people who give a damn about their work. If that's
          you, don't wait for a job post.
        </p>
        <div class="flex items-center justify-center gap-3 flex-wrap">
          <a
            href="mailto:jobs.geniecoupon@gmail.com"
            class="btn btn-primary"
            aria-label="Email your CV"
          >
            Email us your CV
          </a>
          <a
            href="/contact"
            class="btn btn-outline--dark"
            aria-label="Contact page"
          >
            Contact page
          </a>
        </div>
        <p class="text-xs mt-5" style="color: var(--text-muted);">
          CVs are used only for recruitment — we don't share or sell your
          information.
        </p>
      </div>

      <!-- Why work with us -->
      <div class="card-base p-6">
        <h2 class="about-h2 mb-4">Why work with us</h2>
        <div class="space-y-3">
          {
            [
              {
                icon: "🌍",
                title: "Remote-first",
                desc: "Work from wherever you do your best thinking. Flexible hours, no micromanagement.",
              },
              {
                icon: "⚡",
                title: "High ownership",
                desc: "Small team means your work ships fast and has real impact — no endless approval chains.",
              },
              {
                icon: "💰",
                title: "Competitive compensation",
                desc: "Meaningful equity and fair pay. We value the people who build with us.",
              },
              {
                icon: "🚀",
                title: "Fast-moving",
                desc: "We make decisions quickly and ship often. No bureaucracy, no politics.",
              },
            ].map((item) => (
              <div
                class="flex items-start gap-4 p-3 rounded-lg"
                style="border: 1px solid var(--border-default);"
              >
                <span class="text-2xl flex-shrink-0">{item.icon}</span>
                <div>
                  <div
                    class="text-sm font-semibold"
                    style="color: var(--text-primary);"
                  >
                    {item.title}
                  </div>
                  <div
                    class="text-sm mt-0.5"
                    style="color: var(--text-secondary);"
                  >
                    {item.desc}
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Base>

<style>
  .about-h2 {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text-primary);
    padding-left: 0.75rem;
    border-left: 3px solid #89e900;
  }
</style>
