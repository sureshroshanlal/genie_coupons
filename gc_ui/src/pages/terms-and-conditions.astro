---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const pageMeta = {
  title: "Terms & Conditions | Genie Coupon",
  description:
    "The rules for using Genie Coupon. Plain language, no surprises.",
};

const effectiveDate = new Date().toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const termsSchema = {
  "@context": "https://schema.org",
  "@type": "TermsOfService",
  name: "Terms and Conditions",
  url: "https://geniecoupon.com/terms-and-conditions",
  publisher: {
    "@type": "Organization",
    name: "Genie Coupon",
    url: "https://geniecoupon.com",
  },
};

const sections = [
  {
    title: "Using the Site",
    body: "Genie Coupon is a coupon discovery platform — we publish deals, codes, and affiliate links to third-party merchants. You can use it for personal, non-commercial purposes. Don't scrape it, don't try to game it, don't use it for anything unlawful.",
  },
  {
    title: "Affiliate Links",
    body: "Some links on this site are affiliate links. When you click them and make a purchase, we may earn a commission from the merchant. This costs you nothing extra. We're transparent about it — see our Affiliate Disclosure for details.",
  },
  {
    title: "Coupon Accuracy",
    body: "We verify coupons before publishing and update them regularly. That said, merchants can expire or change deals at any time without telling us. We can't guarantee every code works in every cart at every moment. If something's broken, let us know.",
  },
  {
    title: "Third-Party Merchants",
    body: "We link to stores — we don't sell, fulfill, or service anything ourselves. Your purchase is between you and the merchant. Their terms, pricing, return policy, and customer service govern that transaction, not ours.",
  },
  {
    title: "Intellectual Property",
    body: "Everything on geniecoupon.com — content, branding, design, copy — belongs to Genie Coupon or its licensors. Don't copy, reproduce, or redistribute it without permission.",
  },
  {
    title: "Limitation of Liability",
    body: "The site is provided as-is. We don't guarantee it'll be error-free or always available. To the extent permitted by law, Genie Coupon isn't liable for indirect, incidental, or consequential damages arising from your use of the site or reliance on its content.",
  },
  {
    title: "Indemnification",
    body: "If your misuse of this site causes claims or damages against us, you agree to cover those costs. That means don't misuse it.",
  },
  {
    title: "Access & Termination",
    body: "We reserve the right to restrict or terminate access to the site at our discretion for conduct that violates these terms or harms the platform or its users.",
  },
  {
    title: "Governing Law",
    body: "These terms are governed by the laws of the jurisdiction where Genie Coupon operates.",
  },
  {
    title: "Updates to These Terms",
    body: "We'll update these terms when needed. The effective date at the top reflects the current version. Continued use of the site after updates means you accept the changes.",
  },
];
---

<Base meta={pageMeta}>
  <Header />

  <main
    role="main"
    aria-labelledby="terms-heading"
    class="container mx-auto px-4 py-10"
  >
    <div class="max-w-3xl mx-auto">
      <div class="mb-8">
        <h1
          id="terms-heading"
          class="text-3xl font-extrabold text-brand-primary"
        >
          Terms & Conditions
        </h1>
        <div
          class="mt-2 h-1 w-16 rounded-full"
          style="background: linear-gradient(90deg,#89E900,#2d5200);"
        >
        </div>
        <p class="mt-3 text-xs" style="color: var(--text-muted);">
          Effective Date: {effectiveDate}
        </p>
      </div>

      <div
        class="card-base p-6 sm:p-8 space-y-6"
        style="color: var(--text-secondary); line-height: 1.75;"
      >
        <p class="text-sm">
          By using geniecoupon.com you agree to these terms. They're written to
          be readable — here's what they actually say.
        </p>

        {
          sections.map((s) => (
            <section>
              <h2 class="about-h2">{s.title}</h2>
              <p class="mt-2 text-sm">{s.body}</p>
            </section>
          ))
        }

        <section>
          <h2 class="about-h2">Contact</h2>
          <p class="mt-2 text-sm">
            Questions about these terms?
            <a
              href="mailto:support.geniecoupon@gmail.com"
              style="color:#89E900;"
              class="hover:underline ml-1">support.geniecoupon@gmail.com</a
            >
          </p>
        </section>
      </div>
    </div>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(termsSchema)} />
  <Footer />
</Base>

<style>
  .about-h2 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    padding-left: 0.75rem;
    border-left: 3px solid #89e900;
  }
</style>
