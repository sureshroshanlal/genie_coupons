---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { api } from "../../lib/api";
import DOMPurify from "isomorphic-dompurify";
import Img from '../../components/Img.astro';
import SubscribeBox from "../../components/SubscribeBox.jsx";

type BlogDetail = {
  id: string | number;
  slug: string;
  title: string;
  hero_image_url?: string | null;
  category?: string | null;
  created_at?: string | null;
  updated_at?: string | null;
  author?: {
    name?: string | null;
    role?: string | null;
    avatar_url?: string | null;
    bio?: string | null;
    sameAs?: string[];
  } | null;
  breadcrumbs?: { name: string; url: string }[];
  content_html?: string | null;
};

type BlogDetailResponse = {
  data: BlogDetail | null;
  meta?: {
    canonical?: string;
    jsonld?: any;
    title?: string;
    description?: string;
  };
  related?: BlogDetail[];
};

const { slug } = Astro.params as { slug: string };

let resp: BlogDetailResponse | null = null;
try {
  resp = await api.get<BlogDetailResponse>(
    `/blogs/${slug}`,
    {},
    { retries: 2, timeout: 8000 }
  );
} catch (e) {
  console.error("Error fetching blog detail:", e);
  resp = {
    data: null,
    meta: {
      title: "Blog - Genie Coupon",
      description: "Blog temporarily unavailable.",
      canonical: undefined,
      jsonld: undefined,
    },
    related: [],
  };
}

const post = resp?.data || null;
const meta = resp?.meta || {};
const related = resp?.related || [];
const pageTitle =
  meta.title ||
  (post?.title ? `${post.title} - Genie Coupon` : "Blog - Genie Coupon");
const pageDesc = meta.description || "Genie Coupon editorial.";
const canonical = `https://geniecoupon.com${Astro.url.pathname}`;
const jsonld = meta.jsonld;

const _ALLOWED_TAGS = [
  "h1","h2","h3","h4","h5","h6",
  "p","br","div","span",
  "strong","b","em","i","u","s",
  "ul","ol","li",
  "a","img","blockquote","figure","figcaption"
];

const _ALLOWED_ATTR = [
  "href","title","rel","target",
  "src","alt","width","height",
  "id","class","style","loading"
];

const safeBodyHtml = post?.content_html
  ? DOMPurify.sanitize(post.content_html, {
      ALLOWED_TAGS: _ALLOWED_TAGS,
      ALLOWED_ATTR: _ALLOWED_ATTR,
    })
  : null;

let toc: { id: string; text: string }[] = [];
let safeBodyHtmlWithIds = safeBodyHtml || "";

if (safeBodyHtml) {
  const headingRegex = /<(h[23])([^>]*)>([\s\S]*?)<\/\1>/gi;
  const idsSeen = new Set<string>();
  const slugify = (s: string) =>
    String(s || "")
      .trim()
      .toLowerCase()
      .replace(/<[^>]+>/g, "")
      .replace(/[^\w\s-]/g, "")
      .replace(/\s+/g, "-");

  safeBodyHtmlWithIds = safeBodyHtmlWithIds.replace(
    headingRegex,
    (match, tag, attrs = "", inner) => {
      const idMatch = /id\s*=\s*["']([^"']+)["']/i.exec(attrs);
      let id = idMatch ? idMatch[1] : slugify(inner);
      let base = id;
      let n = 1;
      while (idsSeen.has(id)) {
        id = `${base}-${n++}`;
      }
      idsSeen.add(id);
      const plainText = inner.replace(/<[^>]+>/g, "").trim();
      toc.push({ id, text: plainText });
      if (idMatch) {
        return `<${tag}${attrs}>${inner}</${tag}>`;
      } else {
        const attrsNormalized = attrs && attrs.trim() ? " " + attrs.trim() : "";
        return `<${tag} id="${id}"${attrsNormalized}>${inner}</${tag}>`;
      }
    }
  );
}
---

<Base meta={{ title: pageTitle, description: pageDesc, canonical, jsonld }}>
  <Header />
  <main class="container mx-auto px-4 py-10">
    {post ? (
      <>
        <Breadcrumbs breadcrumbs={post.breadcrumbs} />

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 mt-4">
          <!-- Main article -->
          <article class="lg:col-span-2 card-base p-6">
            <header class="mb-6">
              <h1 class="text-3xl md:text-4xl font-bold leading-tight text-brand-primary">
                {post.title}
              </h1>

              <div class="mt-3 flex flex-wrap items-center gap-3 text-sm" style="color: var(--color-text-secondary);">
                {post.category && (
                  <span class="px-2 py-0.5 rounded text-xs" style="background: rgba(137,233,0,0.1); color: #89E900;">
                    {post.category}
                  </span>
                )}
                {post.created_at && <span>{new Date(post.created_at).toLocaleDateString()}</span>}
                {post.updated_at && <span>· Updated {new Date(post.updated_at).toLocaleDateString()}</span>}
              </div>

              {post.author && (
                <div class="mt-4 flex items-center gap-3">
                  <div class="w-12 h-12 rounded-full overflow-hidden flex-shrink-0" style="background: #2a2a2a;">
                    {post.author.avatar_url ? (
                      <Img src={post.author.avatar_url} alt={post.author.name || "Author"} class="w-full h-full object-cover" loading="lazy" />
                    ) : (
                      <div class="w-full h-full flex items-center justify-center text-xs font-bold" style="color: var(--color-text-tertiary);">
                        {post.author.name?.charAt(0) || "A"}
                      </div>
                    )}
                  </div>
                  <div>
                    <div class="font-medium" style="color: var(--color-text-primary);">
                      {post.author.name || "Editorial Team"}
                    </div>
                    {post.author.role && (
                      <div class="text-sm" style="color: var(--color-text-secondary);">
                        {post.author.role}
                      </div>
                    )}
                  </div>
                </div>
              )}
            </header>

            {post.hero_image_url && (
              <figure class="mb-6">
                <Img
                  src={post.hero_image_url}
                  alt={post.title}
                  class="w-full rounded-lg"
                  style="border: 1px solid var(--color-border-tertiary);"
                  loading="lazy"
                />
              </figure>
            )}

            {safeBodyHtml ? (
              <div class="prose max-w-none ql-editor merchant-description">
                <div set:html={safeBodyHtmlWithIds} />
              </div>
            ) : (
              <p style="color: var(--color-text-secondary);">This article has no content.</p>
            )}

            <!-- Share -->
            <div class="mt-8 flex items-center justify-between gap-4">
              <div class="flex items-center gap-2">
                <span class="text-sm" style="color: var(--color-text-secondary);">Share:</span>
                <div class="flex items-center gap-2">
                  <a
                    class="p-2 rounded transition text-sm font-medium"
                    style="color: #89E900;"
                    href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(canonical || Astro.url.href)}&text=${encodeURIComponent(post.title)}`}
                    target="_blank" rel="noopener"
                  >
                    Twitter
                  </a>
                  <a
                    class="p-2 rounded transition text-sm font-medium"
                    style="color: #89E900;"
                    href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonical || Astro.url.href)}`}
                    target="_blank" rel="noopener"
                  >
                    LinkedIn
                  </a>
                </div>
              </div>
              <div>
                <a href="/blogs" class="btn btn-outline text-sm">Back to Blogs</a>
              </div>
            </div>

            <!-- Related posts -->
            {related.length > 0 && (
              <section class="mt-12 card-base p-6">
                <h3 class="text-xl font-semibold mb-4" style="color: #89E900;">Related posts</h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  {related.map((r) => (
                    <a
                      href={`/blogs/${r.slug}`}
                      class="block p-4 rounded transition hover:shadow-sm"
                      style="border: 1px solid var(--color-border-tertiary);"
                    >
                      <div class="font-medium" style="color: var(--color-text-primary);">
                        {r.title}
                      </div>
                      {r.created_at && (
                        <div class="text-xs mt-1" style="color: var(--color-text-secondary);">
                          {new Date(r.created_at).toLocaleDateString()}
                        </div>
                      )}
                    </a>
                  ))}
                </div>
              </section>
            )}
          </article>

          <!-- Sidebar -->
          <aside class="lg:col-span-1 lg:sticky lg:top-4 lg:self-start">
            <div class="space-y-6">
              <div class="sidebar-box p-0 overflow-hidden">
                <div class="card-base p-4">
                  <h3
                    class="text-sm font-bold uppercase tracking-widest mb-3"
                    style="color:#89E900;"
                  >
                    Subscribe and Stay Updated.
                  </h3>
                  <SubscribeBox client:visible source={post.slug} />
                </div>
              </div>

              {toc.length > 0 && (
                <div class="card-base p-4">
                  <h4 class="font-semibold text-sm mb-3" style="color: var(--color-text-secondary);">
                    On this page
                  </h4>
                  <nav class="text-sm space-y-2">
                    {toc.map((h) => (
                      <a
                        href={`#${h.id}`}
                        class="block transition"
                        style="color: var(--color-text-secondary);"
                        onmouseover="this.style.color='#89E900'"
                        onmouseout="this.style.color='var(--color-text-secondary)'"
                      >
                        {h.text}
                      </a>
                    ))}
                  </nav>
                </div>
              )}

              {post.author && (
                <div class="card-base p-4">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full overflow-hidden flex-shrink-0" style="background: #2a2a2a;">
                      {post.author.avatar_url ? (
                        <Img src={post.author.avatar_url} alt={post.author.name || "Author"} class="w-full h-full object-cover" loading="lazy" />
                      ) : (
                        <div class="w-full h-full flex items-center justify-center text-xs font-bold" style="color: var(--color-text-tertiary);">
                          {post.author.name?.charAt(0) || "A"}
                        </div>
                      )}
                    </div>
                    <div>
                      <div class="font-medium" style="color: var(--color-text-primary);">
                        {post.author.name || "Editorial Team"}
                      </div>
                      {post.author.role && (
                        <div class="text-xs" style="color: var(--color-text-secondary);">
                          {post.author.role}
                        </div>
                      )}
                    </div>
                  </div>
                  {post.author.bio && (
                    <div
                      class="mt-3 text-sm"
                      style="color: var(--color-text-secondary);"
                      set:html={DOMPurify.sanitize(post.author.bio)}
                    />
                  )}
                  {post.author.sameAs && post.author.sameAs.length > 0 && (
                    <div class="mt-2 flex gap-2 flex-wrap">
                      {post.author.sameAs.map((link) => (
                        <a
                          href={link}
                          target="_blank"
                          rel="noopener"
                          class="text-xs hover:underline"
                          style="color: #89E900;"
                        >
                          {link.replace(/^https?:\/\//, "")}
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              )}
            </div>
          </aside>
        </div>
      </>
    ) : (
      <section class="py-20 text-center">
        <h1 class="text-2xl font-bold text-brand-primary">Post not found</h1>
        <p class="mt-2" style="color: var(--color-text-secondary);">
          Please check the URL or browse all posts.
        </p>
        <div class="mt-4">
          <a href="/blogs" class="btn btn-outline">Back to Blogs</a>
        </div>
      </section>
    )}
  </main>
  <Footer />
</Base>