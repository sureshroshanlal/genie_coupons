---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const pageMeta = {
  title: "About Genie Coupon",
  description:
    "Genie Coupon is a verified coupon platform built for deal hunters. Learn our story, mission, and how we keep coupons honest.",
};
---

<Base meta={pageMeta}>
  <Header />
  <main class="container mx-auto px-4 py-10">
    <div class="max-w-3xl mx-auto">
      <div class="mb-8">
        <h1 class="text-3xl font-extrabold text-brand-primary">
          About Genie Coupon
        </h1>
        <div
          class="mt-2 h-1 w-16 rounded-full"
          style="background: linear-gradient(90deg,#89E900,#2d5200);"
        >
        </div>
      </div>

      <div
        class="card-base p-6 sm:p-8 space-y-6"
        style="color: var(--text-secondary); line-height: 1.75;"
      >
        <p>
          <strong style="color: var(--text-primary);">Genie Coupon</strong> was built
          for one reason — to make sure you never pay full price for something you
          didn't have to. We're a team of deal hunters, bargain chasers, and coupon
          nerds who believe saving money shouldn't require luck or endless tab-switching.
          With over <strong style="color: var(--text-primary);"
            >14 years in the coupon industry</strong
          >, we've seen what works and what wastes your time. We built Genie
          Coupon to be the latter's opposite.
        </p>

        <section>
          <h2 class="about-h2">Our Mission</h2>
          <p>
            To put real, working coupons in front of real people — fast. No fake
            codes, no expired deals dressed up to look current, no dark
            patterns. Just verified savings from brands you actually shop at,
            surfaced the moment you need them.
          </p>
        </section>

        <section>
          <h2 class="about-h2">How We Verify Coupons</h2>
          <p>
            Every coupon on Genie Coupon goes through a verification process
            before it reaches you:
          </p>
          <ul class="about-list">
            <li>
              Codes are tested against live carts before publishing — no
              assumptions.
            </li>
            <li>
              High-traffic stores are re-verified daily. Others run on a rolling
              review schedule.
            </li>
            <li>
              Limited-time and single-use codes are clearly labeled so there are
              no surprises at checkout.
            </li>
            <li>
              Our team of authors and verifiers are real people with names,
              designations, and accountability.
            </li>
          </ul>
        </section>

        <section>
          <h2 class="about-h2">Editorial Standards</h2>
          <p>
            We have affiliate relationships with some merchants — meaning we may
            earn a commission when you use a coupon from our site. That never
            changes what we publish. A broken code doesn't get listed because a
            brand paid us. We disclose affiliate relationships clearly and our
            editorial decisions are driven by one thing: whether the offer is
            genuinely good for you.
          </p>
        </section>

        <section>
          <h2 class="about-h2">Join the Community</h2>
          <p>
            Thousands of shoppers use Genie Coupon every day to save on
            everything from software subscriptions to fitness gear to home
            essentials. Follow us to stay ahead of the best deals:
          </p>
          <div class="flex flex-wrap gap-3 mt-3">
            {
              [
                {
                  label: "Facebook",
                  href: "https://www.facebook.com/profile.php?id=61580887157989",
                },
                {
                  label: "Instagram",
                  href: "https://www.instagram.com/geniecoupon/",
                },
                {
                  label: "YouTube",
                  href: "https://www.youtube.com/@geniecoupon",
                },
                { label: "Twitter (X)", href: "https://x.com/geniecoupon" },
              ].map((s) => (
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full text-sm font-semibold transition-all"
                  style="background: rgba(137,233,0,0.1); color: #89E900; border: 1px solid rgba(137,233,0,0.2);"
                  onmouseover="this.style.background='rgba(137,233,0,0.2)'"
                  onmouseout="this.style.background='rgba(137,233,0,0.1)'"
                >
                  {s.label}
                </a>
              ))
            }
          </div>
        </section>

        <section>
          <h2 class="about-h2">Get in Touch</h2>
          <p>
            Found a broken code? Have a partnership idea? Just want to say hi?
            We're reachable.
            <a
              href="/contact"
              style="color:#89E900;"
              class="hover:underline ml-1">Contact us →</a
            >
          </p>
        </section>
      </div>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .about-h2 {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    padding-left: 0.75rem;
    border-left: 3px solid #89e900;
  }
  .about-list {
    margin-top: 0.75rem;
    padding-left: 0;
    list-style: none;
  }
  .about-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 0.375rem 0;
    font-size: 0.9375rem;
    border-bottom: 1px solid var(--border-default);
  }
  .about-list li:last-child {
    border-bottom: none;
  }
  .about-list li::before {
    content: "✓";
    color: #89e900;
    font-weight: 700;
    flex-shrink: 0;
  }
</style>
