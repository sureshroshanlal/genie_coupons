---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const pageMeta = {
  title: "Privacy Policy | Genie Coupon",
  description:
    "How Genie Coupon collects, uses, and protects your information. Plain language, no legalese.",
};

const effectiveDate = new Date().toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const privacySchema = {
  "@context": "https://schema.org",
  "@type": "PrivacyPolicy",
  name: "Privacy Policy",
  url: "https://geniecoupon.com/privacy-policy",
  publisher: {
    "@type": "Organization",
    name: "Genie Coupon",
    url: "https://geniecoupon.com",
  },
};

const sections = [
  {
    title: "What We Collect",
    body: "We collect two types of information. First, what you give us directly — email addresses submitted for newsletter sign-ups, contact requests, or support. Second, what your browser sends automatically — device type, IP address, approximate location, referral source, and how you interact with the site (pages viewed, time on page). We don't ask for more than we need.",
  },
  {
    title: "How We Use It",
    body: "To run the site, fix things that break, understand what's useful to you, and deliver relevant coupons and deals. We may use anonymized, aggregated data to measure content performance and affiliate partner effectiveness. We don't use your data to build profiles for third-party advertising.",
  },
  {
    title: "Affiliate & Advertising",
    body: "Genie Coupon earns commissions through affiliate links. Third-party partners may use cookies to measure ad performance. We do not sell your personal information — ever. See our Affiliate Disclosure for more on how commissions work.",
  },
  {
    title: "Cookies",
    body: "We use cookies to keep the site functional and to understand how people use it. You can turn off cookies in your browser settings — some site features may not work perfectly if you do, but the coupons will still be there.",
  },
  {
    title: "How Long We Keep It",
    body: "Only as long as necessary. We retain information to fulfill the purposes in this policy, meet legal obligations, and resolve any disputes. When it's no longer needed, it goes.",
  },
  {
    title: "Your Rights",
    body: "Depending on where you are, you may have the right to access, correct, or delete your personal information, or to object to how we process it. To make a request, contact us at the email below.",
  },
  {
    title: "Children",
    body: "Genie Coupon is not directed at children under 13. We don't knowingly collect information from them. If we discover we have, we'll delete it promptly.",
  },
  {
    title: "Third-Party Links",
    body: "Our site links to merchant and partner websites. Once you leave geniecoupon.com, this policy doesn't apply. Check the privacy policy of any external site before sharing your information with them.",
  },
  {
    title: "Security",
    body: "We use reasonable technical measures to protect your information. No system online is 100% secure, but we take it seriously and work to keep things locked down.",
  },
  {
    title: "Policy Updates",
    body: "We'll update this policy when our practices change. The effective date at the top will reflect the latest version. Continued use of the site after an update means you accept the revised terms.",
  },
];
---

<Base meta={pageMeta}>
  <Header />

  <main
    role="main"
    aria-labelledby="privacy-heading"
    class="container mx-auto px-4 py-10"
  >
    <div class="max-w-3xl mx-auto">
      <div class="mb-8">
        <h1
          id="privacy-heading"
          class="text-3xl font-extrabold text-brand-primary"
        >
          Privacy Policy
        </h1>
        <div
          class="mt-2 h-1 w-16 rounded-full"
          style="background: linear-gradient(90deg,#89E900,#2d5200);"
        >
        </div>
        <p class="mt-3 text-xs" style="color: var(--text-muted);">
          Effective Date: {effectiveDate}
        </p>
      </div>

      <div
        class="card-base p-6 sm:p-8 space-y-6"
        style="color: var(--text-secondary); line-height: 1.75;"
      >
        <p>
          We'll keep this simple. Genie Coupon collects minimal data, uses it
          only to run the platform, and doesn't sell it. Here's the full
          picture.
        </p>

        {
          sections.map((s) => (
            <section>
              <h2 class="about-h2">{s.title}</h2>
              <p class="mt-2 text-sm">{s.body}</p>
            </section>
          ))
        }

        <section>
          <h2 class="about-h2">Contact</h2>
          <p class="mt-2 text-sm">
            Questions about this policy? Reach out:
            <a
              href="mailto:support.geniecoupon@gmail.com"
              style="color:#89E900;"
              class="hover:underline ml-1">support.geniecoupon@gmail.com</a
            >
          </p>
        </section>
      </div>
    </div>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(privacySchema)} />
  <Footer />
</Base>

<style>
  .about-h2 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    padding-left: 0.75rem;
    border-left: 3px solid #89e900;
  }
</style>
