---
import HeaderSearchIsland from "../components/islands/HeaderSearchIsland.jsx";

const MAIN = "https://geniecoupon.com";
const isSubdomain = Astro.locals?.isSubdomain === true;
const base = isSubdomain ? MAIN : "";

const nav = [
  { href: `${base}/stores`, label: "Stores" },
  { href: `${base}/categories`, label: "Categories" },
  { href: `${base}/blogs`, label: "Blogs" },
];
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700&display=swap"
  rel="stylesheet"
/>

<a class="skip-link" href="#content">Skip to content</a>

<header
  id="top"
  role="banner"
  class="sticky top-0 z-50"
  style="background:#1a1a1a; border-bottom: 1px solid #2a2a2a; box-shadow: 0 1px 0 rgba(137,233,0,0.08);"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-4 h-14">
      <!-- Logo -->
      <a
        href={isSubdomain ? MAIN : "/"}
        aria-label="Genie Coupon home"
        class="flex items-center gap-2 shrink-0 group"
      >
        <img
          src="/GC_logo.webp"
          alt=""
          width="36"
          height="36"
          class="rounded-sm"
          loading="eager"
          aria-hidden="true"
        />
        <span class="header-logo-text">
          Genie<span style="color:#89E900;">Coupons</span>
        </span>
      </a>

      <!-- Search — centered, max width -->
      <div class="flex-1 flex justify-center px-4">
        <div class="header-search-wrap">
          <div
            class="absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none"
          >
            <svg
              class="w-4 h-4"
              style="color:#89E900;"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle
                cx="11"
                cy="11"
                r="6"
                stroke-linecap="round"
                stroke-linejoin="round"></circle>
              <path
                d="M21 21l-4.35-4.35"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </div>
          <div class="pl-9 pr-3 py-1.5 w-full">
            <HeaderSearchIsland client:visible />
          </div>
        </div>
      </div>

      <!-- Nav -->
      <nav aria-label="Main navigation" class="shrink-0">
        <ul class="flex items-center gap-1">
          {
            nav.map((n) => (
              <li>
                <a href={n.href} class="header-nav-link">
                  {n.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>

<main id="content"></main>

<style>
  .header-logo-text {
    font-family: "Fredoka", sans-serif;
    font-weight: 700;
    font-size: 1.25rem;
    color: #f5f5f0;
    line-height: 1;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .header-search-wrap {
    position: relative;
    width: 100%;
    max-width: 480px;
    border-radius: 999px;
    background: #2a2a2a;
    border: 1px solid #333333;
    transition:
      border-color 150ms ease,
      box-shadow 150ms ease;
  }

  .header-search-wrap:focus-within {
    border-color: rgba(137, 233, 0, 0.5);
    box-shadow: 0 0 0 3px rgba(137, 233, 0, 0.08);
  }

  .header-nav-link {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #b0b0a8;
    border-radius: 999px;
    text-decoration: none;
    transition:
      background 150ms ease,
      color 150ms ease;
    white-space: nowrap;
  }

  .header-nav-link:hover {
    background: rgba(137, 233, 0, 0.1);
    color: #89e900;
  }

  /* Mobile: stack search below logo+nav */
  @media (max-width: 767px) {
    header .max-w-7xl > div {
      flex-wrap: wrap;
      height: auto;
      padding: 0.5rem 0;
      gap: 0.5rem;
    }

    .header-search-wrap {
      max-width: 100%;
      order: 3;
      flex: 0 0 100%;
    }

    .header-logo-text {
      font-size: 1.1rem;
    }

    .header-nav-link {
      padding: 0.25rem 0.5rem;
      font-size: 0.8rem;
    }
  }
</style>
