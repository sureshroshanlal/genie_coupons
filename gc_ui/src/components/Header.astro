---
import HeaderSearchIsland from "../components/islands/HeaderSearchIsland.jsx";

const MAIN = "https://geniecoupon.com";
const isSubdomain = Astro.locals?.isSubdomain === true;
const base = isSubdomain ? MAIN : "";

const nav = [
  { href: `${base}/stores`, label: "Stores" },
  { href: `${base}/categories`, label: "Categories" },
  { href: `${base}/coupons`, label: "Coupons" },
  { href: `${base}/blogs`, label: "Blogs" },
];
---

<a class="skip-link" href="#content">Skip to content</a>

<header
  id="top"
  role="banner"
  class="sticky top-0 z-50 border-b border-[#2e2e2e]"
  style="background:#222222;"
>
  <div class="container mx-auto px-4 py-3">
    <div
      class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between"
    >
      <!-- Logo -->
      <a
        href={isSubdomain ? MAIN : "/"}
        aria-label="Genie Coupon home"
        class="flex items-center gap-3 shrink-0"
      >
        <img
          src="/GC_logo.webp"
          alt="Genie Coupon logo"
          width="70"
          height="55"
          class="rounded-sm shadow-sm"
          loading="eager"
        />
        <img
          src="/GC_text.webp"
          alt="Genie Coupon title logo"
          width="140"
          height="55"
          style="filter: brightness(0) saturate(100%) invert(78%) sepia(60%) saturate(600%) hue-rotate(40deg) brightness(105%);"
          class="rounded-sm"
          loading="eager"
        />
      </a>

      <!-- Search -->
      <div class="w-full md:flex-1 md:px-6">
        <div
          class="relative rounded-full border shadow-sm"
          style="background:#2e2e2e; border-color:#3a3a3a;"
        >
          <div
            class="absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-5 h-5"
              style="color:#89E900;"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <circle
                cx="11"
                cy="11"
                r="6"
                stroke-linecap="round"
                stroke-linejoin="round"></circle>
              <path
                d="M21 21l-4.35-4.35"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </div>
          <div class="pl-10 pr-4 py-2">
            <HeaderSearchIsland client:visible />
          </div>
        </div>
      </div>

      <!-- Nav -->
      <nav aria-label="Main navigation" class="flex justify-center">
        <ul class="flex gap-2 flex-wrap items-center">
          {
            nav.map((n) => (
              <li>
                <a
                  href={n.href}
                  class="px-4 py-2 text-sm font-semibold rounded-full transition-all duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2"
                  style="color:#e0e0e0;"
                  onmouseover="this.style.background='#89E900'; this.style.color='#222222';"
                  onmouseout="this.style.background='transparent'; this.style.color='#e0e0e0';"
                >
                  {n.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>

<main id="content"></main>
