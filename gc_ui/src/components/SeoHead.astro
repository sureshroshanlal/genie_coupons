---
const props = Astro.props as any;
const meta = (props && props.meta) || {};
const GA_ID = props.GA_ID;

const siteName = "Genie Coupon";

// Canonical link locked to root domain
const canonical = meta.canonical
  ? meta.canonical // use explicitly passed canonical if available
  : `https://geniecoupon.com${Astro.url.pathname}`;

// utility: returns "{Mon, YYYY}"
function getCurrentMonthYear() {
  const now = new Date();
  const month = now.toLocaleString("en-US", { month: "long" }); // e.g. "Sep"
  const year = now.getFullYear(); // e.g. 2025
  return `( ${month}, ${year} ) | Verified`;
}

function hasMonthYearSuffix(text: string) {
  if (!text || typeof text !== "string") return false;
  // matches both old {Sep, 2025} and new [April 2026] patterns
  return (
    /\{\s*[A-Za-z]{3},\s*\d{4}\s*\}$/.test(text.trim()) ||
    /\[[A-Za-z]+ \d{4}\]/.test(text)
  );
}

const suffix = getCurrentMonthYear();

// base values (before suffix)
const rawTitle =
  meta.title ||
  "Genie Coupon | Verified and Working Deals, Coupons & Discounts ";
const rawDesc =
  meta.description ||
  "Real savings on Every Purchase, no expired junk — only Verified Coupons and Deals.";

// append suffix if not already present
const defaultTitle = hasMonthYearSuffix(rawTitle)
  ? rawTitle
  : `${rawTitle} ${suffix}`;

const defaultDesc = meta.description
  ? meta.description
  : `${rawDesc} ${suffix}`;

const ogImage = meta.og_image || "/og-default.webp";
const jsonld = meta.jsonld;
---

<head>
  <!-- GA preconnect + stub -->
  <!-- <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
  <link rel="preconnect" href="https://www.google-analytics.com" crossorigin /> -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    window.gtag = window.gtag || gtag;
  </script>

  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{defaultTitle}</title>
  <meta name="description" content={defaultDesc} />
  {canonical && <link rel="canonical" href={canonical} />}

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  {defaultTitle && <meta property="og:title" content={defaultTitle} />}
  {defaultDesc && <meta property="og:description" content={defaultDesc} />}
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  {defaultTitle && <meta name="twitter:title" content={defaultTitle} />}
  {defaultDesc && <meta name="twitter:description" content={defaultDesc} />}
  <meta name="twitter:image" content={ogImage} />
  {
    meta.preloadHero && meta.heroSrc ? (
      <link
        rel="preload"
        as="image"
        href={meta.heroSrc}
        imagesrcset={meta.heroSrcSetWebp}
        imagesizes="(max-width: 480px) 516px, (max-width: 1024px) 800px, 1200px"
        fetchpriority="high"
      />
    ) : null
  }
  <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap"
    onload="this.onload=null;this.rel='stylesheet'"
  />

  <noscript>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap"
    />
  </noscript>
  {
    jsonld && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
    )
  }

  <!-- Consent-gated GA loader -->
  {
    GA_ID && (
      <script
        set:html={`
          (function(){
            var GA_ID='${GA_ID}';
            if(!GA_ID) return;

            var inited = false;
            function hasConsent() {
              var c = localStorage.getItem('gc_cookie_consent') === 'accepted';
              return c;
            }
            function init() {
              if (inited || !hasConsent()) { return; }
              inited = true;
              var s = document.createElement('script');
              s.async = true;
              s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
              s.crossOrigin = 'anonymous';
              document.head.appendChild(s);
              s.addEventListener('load', function(){
                try{ gtag('js', new Date()); gtag('config', GA_ID, { send_page_view: false }); gtag('event','page_view',{page_location:location.href}); }catch(e){}
              });
            }

            if (hasConsent()) {
              init();
            } else {
              var evs=['pointerdown','keydown','touchstart','scroll'];
              function onFirst(){ init(); remove(); }
              function add(){ evs.forEach(e=>window.addEventListener(e,onFirst,{once:true,passive:true})); }
              function remove(){ evs.forEach(e=>window.removeEventListener(e,onFirst)); }
              add();
              setTimeout(function(){ if(!inited) init(); }, 10000);
            }

            window.addEventListener('cookie-consent-changed', function(e){
              if (e.detail === 'accepted') init();
            });
          })();
        `}
      />
    )
  }
</head>
