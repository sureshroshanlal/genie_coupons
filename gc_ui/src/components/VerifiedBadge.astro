---
// src/components/VerifiedBadge.astro

import Img from '../components/Img.astro';

interface Props {
  name: string;
  designation: string;
  lastVerified: string;
  successRate: number;
  verifyingSince?: string | null;
  avatarUrl?: string | null;
  authorSlug: string;
  sameAs: { type: string; url: string }[];
}

const { name, designation, lastVerified, successRate, verifyingSince, avatarUrl, authorSlug, sameAs } = Astro.props;

const icons: Record<string, string> = {
  linkedin: `<svg viewBox="0 0 24 24" class="w-3.5 h-3.5 fill-current"><path d="M4.98 3.5C4.98 4.88 3.86 6 2.48 6S0 4.88 0 3.5 1.12 1 2.48 1s2.5 1.12 2.5 2.5zM.22 8h4.52v14H.22V8zm7.56 0h4.33v1.92h.06c.6-1.14 2.06-2.34 4.24-2.34 4.54 0 5.38 2.99 5.38 6.87V22h-4.52v-6.74c0-1.6-.03-3.66-2.23-3.66-2.24 0-2.58 1.75-2.58 3.55V22H7.78V8z"/></svg>`,
  facebook: `<svg viewBox="0 0 24 24" class="w-3.5 h-3.5 fill-current"><path d="M22 12a10 10 0 10-11.5 9.87v-6.99H7.9V12h2.6V9.8c0-2.56 1.53-3.97 3.87-3.97 1.12 0 2.3.2 2.3.2v2.53h-1.3c-1.28 0-1.68.8-1.68 1.62V12h2.86l-.46 2.88h-2.4v6.99A10 10 0 0022 12z"/></svg>`,
  x: `<svg viewBox="0 0 24 24" class="w-3.5 h-3.5 fill-current"><path d="M18.244 2H21l-6.54 7.48L22 22h-6.828l-5.35-7.03L3.8 22H1l7.02-8.02L2 2h6.93l4.84 6.41L18.244 2z"/></svg>`,
  instagram: `<svg viewBox="0 0 24 24" class="w-3.5 h-3.5 fill-current"><path d="M7.75 2h8.5A5.75 5.75 0 0122 7.75v8.5A5.75 5.75 0 0116.25 22h-8.5A5.75 5.75 0 012 16.25v-8.5A5.75 5.75 0 017.75 2zm4.25 5.5a4.75 4.75 0 100 9.5 4.75 4.75 0 000-9.5zm6-1.25a1.25 1.25 0 11-2.5 0 1.25 1.25 0 012.5 0z"/></svg>`,
  tiktok: `<svg viewBox="0 0 24 24" class="w-3.5 h-3.5 fill-current"><path d="M12 2v14.5a3.5 3.5 0 11-3.5-3.5c.28 0 .55.03.81.1V9.8a7 7 0 100 13.9A7 7 0 0016 16.7V8.54a8.2 8.2 0 004.5 1.36V6.3A5.7 5.7 0 0116 2h-4z"/></svg>`,
};
---

<div class="vb-card">
  <!-- Top accent bar -->
  <div class="vb-accent-bar" />

  <!-- Verified stamp row -->
  <div class="vb-stamp-row">
    <div class="vb-stamp">
      <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" aria-hidden="true">
        <path fill="#89E900" d="M12 2L4 5v6c0 5.25 3.5 10.15 8 11.35C16.5 21.15 20 16.25 20 11V5l-8-3z"/>
        <path fill="#181818" d="M9.5 16.5l-3-3 1.41-1.41L9.5 13.67l6.59-6.58L17.5 8.5z"/>
      </svg>
      <span>Verified &amp; Tested</span>
    </div>
    <span class="vb-verified-time">{lastVerified}</span>
  </div>

  <!-- Avatar + identity -->
  <div class="vb-identity">
    <div class="vb-avatar-wrap">
      {avatarUrl ? (
        <Img src={avatarUrl} alt={name} class="vb-avatar-img" loading="lazy" />
      ) : (
        <div class="vb-avatar-fallback">{name.charAt(0)}</div>
      )}
      <div class="vb-avatar-ring" aria-hidden="true" />
    </div>

    <div class="vb-identity-text">
      <a href={`https://geniecoupon.com/authors/${authorSlug}`} class="vb-name">{name}</a>
      <div class="vb-designation">{designation}</div>
      {sameAs.length > 0 && (
        <div class="vb-socials">
          {sameAs.map((item) => (
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer me"
              aria-label={item.type}
              class="vb-social-btn"
              set:html={icons[item.type]}
            />
          ))}
        </div>
      )}
    </div>
  </div>

  <!-- Stats row -->
  <div class="vb-stats">
    <div class="vb-stat">
      <span class="vb-stat-value" style="color:#89E900;">{successRate}%</span>
      <span class="vb-stat-label">Success Rate</span>
    </div>
    {verifyingSince && (
      <div class="vb-stat-divider" />
      <div class="vb-stat">
        <span class="vb-stat-value">{verifyingSince}</span>
        <span class="vb-stat-label">Verifying Since</span>
      </div>
    )}
  </div>
</div>

<style>
  .vb-card {
    position: relative;
    background: var(--bg-subtle);
    border: 1px solid var(--card-border);
    border-radius: 14px;
    overflow: hidden;
    padding: 0;
  }

  .vb-card:hover {
    border-color: var(--card-hover-border);
    box-shadow: var(--card-hover-shadow);
    @apply -translate-y-0.5;
  }
  /* Top lime accent line */
  .vb-accent-bar {
    height: 3px;
    background: linear-gradient(90deg, #89E900, #2d5200);
    width: 100%;
  }

  .vb-stamp-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem 0;
  }

  .vb-stamp {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    background: rgba(137, 233, 0, 0.1);
    border: 1px solid rgba(137, 233, 0, 0.2);
    border-radius: 999px;
    padding: 0.25rem 0.625rem;
    font-size: 0.7rem;
    font-weight: 700;
    color: #89E900;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .vb-verified-time {
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  /* Identity */
  .vb-identity {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--border-default);
  }

  .vb-avatar-wrap {
    position: relative;
    flex-shrink: 0;
  }

  .vb-avatar-img {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
  }

  .vb-avatar-fallback {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(137, 233, 0, 0.12);
    border: 2px solid rgba(137, 233, 0, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    font-weight: 800;
    color: #89E900;
  }

  .vb-avatar-ring {
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 2px solid rgba(137, 233, 0, 0.35);
    pointer-events: none;
  }

  .vb-identity-text {
    flex: 1;
    min-width: 0;
  }

  .vb-name {
    display: block;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text-primary);
    text-decoration: none;
    truncate: true;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 150ms ease;
  }

  .vb-name:hover {
    color: #89E900;
  }

  .vb-designation {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin-top: 0.125rem;
  }

  .vb-socials {
    display: flex;
    gap: 0.375rem;
    margin-top: 0.5rem;
  }

  .vb-social-btn {
    width: 24px;
    height: 24px;
    border-radius: 6px;
    background: var(--bg-elevated);
    border: 1px solid var(--border-default);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    transition: all 150ms ease;
  }

  .vb-social-btn:hover {
    background: rgba(137, 233, 0, 0.1);
    border-color: rgba(137, 233, 0, 0.3);
    color: #89E900;
  }

  /* Stats */
  .vb-stats {
    display: flex;
    align-items: center;
    padding: 0.75rem 1rem;
    gap: 0;
  }

  .vb-stat {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
  }

  .vb-stat-value {
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1;
  }

  .vb-stat-label {
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .vb-stat-divider {
    width: 1px;
    height: 32px;
    background: var(--border-default);
    margin: 0 0.5rem;
  }
</style>