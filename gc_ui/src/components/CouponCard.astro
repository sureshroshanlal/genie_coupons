---
// src/components/CouponCard.astro
import RevealButton from "./islands/RevealButton.jsx";
import CouponReviews from "./reviews/CouponReviews.jsx";
import { AuthProvider } from "../context/AuthContext.jsx";

const { coupon, storeSlug = "", sectionId = "default" } = Astro.props;

const c = coupon || {};
const id = String(c.id ?? "");
const sid = String(sectionId ?? "default");

// Discount badge
const discountType = c.discount_type || "none";
const discountValue = c.discount_value ?? null;

let badgeTop = "DEAL";
let badgeBottom = "";
let badgeBg = "background:#EEFF99;";
let badgeBorder = "border-color:#89E900;";
let badgeTextColor = "color:#2A3300;";

if (discountType === "percent" && discountValue) {
  badgeTop = `${discountValue}%`;
  badgeBottom = "OFF";
  badgeBg = "background:#ECFAD0;";
  badgeBorder = "border-color:#B8F200;";
  badgeTextColor = "color:#2A3300;";
} else if (discountType === "flat" && discountValue) {
  badgeTop = `$${discountValue}`;
  badgeBottom = "";
  badgeBg = "background:#fef3c7;";
  badgeBorder = "border-color:#fcd34d;";
  badgeTextColor = "color:#92400e;";
}

// Expiry
const endsAt = c.ends_at
  ? new Date(c.ends_at).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    })
  : "";

// Click count
const clickCount =
  Number.isFinite(Number(c.click_count)) && Number(c.click_count) > 0
    ? Number(c.click_count)
    : 0;
---

<div
  class="coupon-card card-base p-3 flex flex-col gap-2.5"
  data-type={c.coupon_type || "deal"}
  data-editor={c.is_editor ? "true" : "false"}
>
  <!-- Verified badges row -->
  <div class="w-full flex items-center justify-between">
    <div class="flex items-center gap-1.5">
      <img
        src="/images/verified-badge.webp"
        alt="Verified"
        class="h-4 w-4 object-contain"
        loading="lazy"
        decoding="async"
      />
      <span class="text-xs text-brand-secondary font-medium">Verified</span>
    </div>
    <div class="flex items-center gap-1.5">
      <span class="text-xs text-brand-secondary font-medium">Re-verified</span>
      <img
        src="/images/reverified-badge.webp"
        alt="Re-verified"
        class="h-4 w-4 object-contain"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>

  <!-- Discount badge + title + description -->
  <div class="flex items-start gap-3">
    <!-- Discount badge -->
    <div
      class="flex-shrink-0 flex flex-col items-center justify-center rounded-lg px-3 py-2 border"
      style={`${badgeBg} ${badgeBorder} min-width:60px; width:60px;`}
    >
      <span
        class="font-extrabold leading-tight text-center"
        style={`font-size:1rem; ${badgeTextColor}`}
      >
        {badgeTop}
      </span>
      {
        badgeBottom && (
          <span
            class="text-xs font-semibold tracking-wide text-center"
            style={`${badgeTextColor} opacity:0.7;`}
          >
            {badgeBottom}
          </span>
        )
      }
    </div>

    <!-- Title + description -->
    <div class="flex-1 min-w-0 flex flex-col gap-0.5">
      <div
        class="relative group"
        tabindex="0"
        aria-describedby={`title-tip-${id}`}
      >
        <h3
          class="font-semibold text-sm leading-snug truncate block"
          style="color:#B0B0A8;"
        >
          {c.title ?? ""}
        </h3>
        <div
          id={`title-tip-${id}`}
          role="tooltip"
          class="absolute left-0 top-full mt-1 z-50 max-w-xs w-max p-2 rounded bg-black text-white text-xs shadow-lg break-words opacity-0 pointer-events-none transition-all duration-150 group-hover:opacity-100 group-focus:opacity-100"
          aria-hidden="true"
        >
          {c.title ?? ""}
        </div>
      </div>
      <p
        class="text-xs leading-relaxed overflow-hidden"
        style="color:#B0B0A8; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2;"
      >
        {c.description ?? ""}
      </p>
    </div>
  </div>

  <!-- Bottom row: expiry + used-by + reveal button -->
  <div class="flex items-center justify-between gap-2 flex-wrap">
    <div class="flex items-center gap-2 flex-wrap">
      {
        endsAt && (
          <div class="flex items-center gap-1 text-xs text-gray-400">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-3 w-3"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.6"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              />
            </svg>
            <span>Expires {endsAt}</span>
          </div>
        )
      }
      {
        clickCount > 0 && (
          <div class="flex items-center gap-1 text-xs text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-3 w-3"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.6"
                d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m9-1.13a4 4 0 10-8 0 4 4 0 008 0z"
              />
            </svg>
            <span>
              {clickCount} {clickCount === 1 ? "user" : "users"}
            </span>
          </div>
        )
      }
    </div>

    <!-- Reveal button island -->
    <RevealButton
      client:visible
      offerId={id}
      couponType={c.coupon_type || "deal"}
      storeSlug={storeSlug}
      merchant={c.merchant ?? null}
    />
  </div>

  <!-- Reviews island — renders inline, no portal -->
  <CouponReviews
    client:visible
    couponId={id}
    initialReviews={c.reviews ?? null}
    initialAggregate={c.review_aggregate ?? null}
  />
</div>
