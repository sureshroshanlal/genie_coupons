---
const isSubdomain = Astro.locals?.isSubdomain === true;
const base = isSubdomain ? "https://geniecoupon.com" : "";
---

<footer
  role="contentinfo"
  class="w-full"
  style="background: var(--bg-surface); border-top: 1px solid #2a2a2a; box-shadow: 0 -1px 0 rgba(137,233,0,0.08);"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 items-start">
      <!-- Brand — spans full width on mobile, 1 col on desktop -->
      <div class="col-span-2 md:col-span-1 space-y-3">
        <a
          href={isSubdomain ? "https://geniecoupon.com" : "/"}
          class="flex items-center gap-2 mb-1"
          aria-label="Genie Coupon home"
        >
          <img
            src="/GC_logo.webp"
            alt=""
            width="36"
            height="36"
            class="rounded-sm"
            aria-hidden="true"
          />
          <span class="footer-logo-text">
            Genie<span style="color:#89E900;">Coupons</span>
          </span>
        </a>
        <p
          class="text-sm leading-relaxed"
          style="color: var(--text-secondary); max-width: 240px;"
        >
          Verified coupons, trusted stores, and savings you can count on.
        </p>
      </div>

      <!-- Company -->
      <div class="space-y-3">
        <p
          class="text-xs font-bold uppercase tracking-widest"
          style="color:#89E900;"
        >
          Company
        </p>
        <ul class="space-y-2 text-sm">
          <li><a href={`${base}/about`} class="footer-link">About</a></li>
          <li><a href={`${base}/contact`} class="footer-link">Contact</a></li>
          <li><a href={`${base}/careers`} class="footer-link">Careers</a></li>
          <li>
            <a href={`${base}/affiliate-disclosure`} class="footer-link"
              >Affiliate Disclosure</a>
          </li>
          <li>
            <a href={`${base}/privacy-policy`} class="footer-link"
              >Privacy Policy</a>
          </li>
          <li>
            <a href={`${base}/terms-and-conditions`} class="footer-link"
              >Terms & Conditions</a>
          </li>
        </ul>
      </div>

      <!-- Resources -->
      <div class="space-y-3">
        <p
          class="text-xs font-bold uppercase tracking-widest"
          style="color:#89E900;"
        >
          Resources
        </p>
        <ul class="space-y-2 text-sm">
          <li><a href={`${base}/stores`} class="footer-link">Stores</a></li>
          <li><a href={`${base}/categories`} class="footer-link">Categories</a></li>
          <li><a href={`${base}/blogs`} class="footer-link">Blogs</a></li>
          <li><a href={`${base}/authors`} class="footer-link">Authors</a></li>
          <li>
            <a href={`${base}/how-it-works`} class="footer-link"
              >How it works</a>
          </li>
          <li><a href={`${base}/faq`} class="footer-link">FAQ</a></li>
        </ul>
      </div>

      <!-- Connect -->
      <div class="space-y-3 col-span-2 md:col-span-1">
        <p
          class="text-xs font-bold uppercase tracking-widest"
          style="color:#89E900;"
        >
          Connect
        </p>
        <p class="text-sm" style="color: var(--text-secondary);">
          Follow us for updates and exclusive coupons.
        </p>
        <div class="flex items-center gap-2 mt-1">
          <a
            href="https://www.facebook.com/profile.php?id=61575535957327"
            aria-label="Facebook"
            class="social-btn"
            target="_blank"
            rel="noopener"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M22 12a10 10 0 1 0-11.6 9.9v-7h-2.4v-3h2.4V9.6c0-2.4 1.4-3.8 3.6-3.8 1 0 2 .2 2 .2v2.2h-1.1c-1.1 0-1.5.7-1.5 1.5V12h2.6l-.4 3h-2.2v7A10 10 0 0 0 22 12z"
              ></path></svg
            >
          </a>
          <a
            href="https://www.instagram.com/genie_coupon/"
            aria-label="Instagram"
            class="social-btn"
            target="_blank"
            rel="noopener"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M7 2C4.2 2 2 4.2 2 7v10c0 2.8 2.2 5 5 5h10c2.8 0 5-2.2 5-5V7c0-2.8-2.2-5-5-5H7zm10 2c1.7 0 3 1.3 3 3v10c0 1.7-1.3 3-3 3H7c-1.7 0-3-1.3-3-3V7c0-1.7 1.3-3 3-3h10zm-5 3a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 2a3 3 0 1 1 0 6 3 3 0 0 1 0-6zm4.8-.9a1.1 1.1 0 1 0 0-2.2 1.1 1.1 0 0 0 0 2.2z"
              ></path></svg
            >
          </a>
          <a
            href="https://www.youtube.com/@GenieCoupon"
            aria-label="YouTube"
            class="social-btn"
            target="_blank"
            rel="noopener"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.2 3.5 12 3.5 12 3.5s-7.2 0-9.4.6A3 3 0 0 0 .5 6.2 31.2 31.2 0 0 0 0 12c0 1.9.2 3.9.5 5.8a3 3 0 0 0 2.1 2.1c2.2.6 9.4.6 9.4.6s7.2 0 9.4-.6a3 3 0 0 0 2.1-2.1c.3-1.9.5-3.9.5-5.8 0-1.9-.2-3.9-.5-5.8zM9.5 15.6V8.4l6.2 3.6-6.2 3.6z"
              ></path></svg
            >
          </a>
          <a
            href="https://x.com/GenieCouponz"
            aria-label="Twitter (X)"
            class="social-btn"
            target="_blank"
            rel="noopener"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M18.9 2H22l-7.7 8.8L23 22h-7.2l-5.6-7.3L4.9 22H2l8.2-9.4L1 2h7.3l5 6.6L18.9 2z"
              ></path></svg
            >
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-8 pt-4" style="border-top: 1px solid #2a2a2a;">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-2">
        <p class="text-xs" style="color: var(--text-muted);">
          © {new Date().getFullYear()} Genie Coupon. All rights reserved.
        </p>
        <a
          href="#top"
          class="text-xs transition"
          style="color: var(--text-muted);"
          onmouseover="this.style.color='#89E900'"
          onmouseout="this.style.color='var(--text-muted)'"
        >
          ↑ Back to top
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-logo-text {
    font-family: "Fredoka", sans-serif;
    font-weight: 700;
    font-size: 1.2rem;
    color: #f5f5f0;
    line-height: 1;
    letter-spacing: -0.01em;
  }
</style>
